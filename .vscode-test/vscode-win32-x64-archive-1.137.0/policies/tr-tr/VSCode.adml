			<string id="AgentsVoice">AgentsVoice</string>
			<string id="AgentsVoice_agents_voice_enabled">Sohbet görünümünde, sesle yönlendirilen kodlama konuşmaları için Ses Modu panelini etkinleştirin.</string>
			<string id="BrowserChatTools">BrowserChatTools</string>
			<string id="BrowserChatTools_browser_enableChatTools">Etkinleştirildiğinde, sohbet araçları Tümleşik Tarayıcı'da sayfaları açmak ve bu sayfalarla etkileşim kurmak için tarayıcı araçlarını kullanabilir.</string>
			<string id="ChatAgentAllowedNetworkDomains">ChatAgentAllowedNetworkDomains</string>
			<string id="ChatAgentAllowedNetworkDomains_chat_agent_allowedNetworkDomains">Aracı araçlarının (getirme aracı, tümleşik tarayıcı) ağ erişimi için izin verilen etki alanları. {0} veya {1} etkinleştirildiğinde geçerlidir. {2} etkinleştirildiğinde tüm etki alanlarına izin verilir. {3} gibi joker karakterleri destekler. Hem izin verilenler hem de reddedilenler listeleri boşsa tüm etki alanları engellenir. Reddedilen etki alanları (bkz. {4}) öncelik kazanır.</string>
			<string id="ChatAgentDeniedNetworkDomains">ChatAgentDeniedNetworkDomains</string>
			<string id="ChatAgentDeniedNetworkDomains_chat_agent_deniedNetworkDomains">Aracı araçlarının (getirme aracı, tümleşik tarayıcı) ağ erişimi için reddedilen etki alanları. {0} veya {1} etkinleştirildiğinde geçerlidir. Bu, {2} etkinleştirildiğinde geçerli değildir. {3} üzerinde önceliğe sahiptir. {4} gibi joker karakterleri destekler.</string>
			<string id="ChatAgentExtensionTools">ChatAgentExtensionTools</string>
			<string id="ChatAgentExtensionTools_chat_extensionToolsEnabled">Üçüncü taraf uzantıları tarafından sağlanan araçların kullanımını etkinleştirin.</string>
			<string id="ChatAgentHostCustomTerminalTool">ChatAgentHostCustomTerminalTool</string>
			<string id="ChatAgentHostCustomTerminalTool_chat_agentHost_customTerminalTool_enabled_policy">Enable the Agent Host custom terminal tool override for Copilot SDK sessions.</string>
			<string id="ChatAgentMode">ChatAgentMode</string>
			<string id="ChatAgentMode_chat_agent_enabled_description">Etkinleştirildiğinde, aracı modu sohbetten etkinleştirilebilir ve yan etkileri olan aracı bağlamlarındaki araçlar kullanılabilir.</string>
			<string id="ChatAgentNetworkFilter">ChatAgentNetworkFilter</string>
			<string id="ChatAgentNetworkFilter_chat_agent_networkFilter">Etkinleştirildiğinde, aracı araçlarının (getirme aracı, tümleşik tarayıcı) ağ erişimi {0} ve {1} doğrultusunda kısıtlanır. {2} etkinleştirildiğinde bu araçlara etki alanı filtrelemesi de uygulanır.</string>
			<string id="ChatAllowedMcpServers">ChatAllowedMcpServers</string>
			<string id="ChatAllowedMcpServers_chat_mcp_allowedServers_policy">Allowlist of Model Context Protocol servers. When set, only servers matching an entry may be installed or run; omit entirely to allow all servers (subject to the deny list).</string>
			<string id="ChatAllowManagedHooksOnly">ChatAllowManagedHooksOnly</string>
			<string id="ChatAllowManagedHooksOnly_chat_hooks_allowManagedOnly_policy">Allows hooks only from enterprise-managed sources and plugins force-enabled by policy.</string>
			<string id="ChatAllowManagedMcpServersOnly">ChatAllowManagedMcpServersOnly</string>
			<string id="ChatAllowManagedMcpServersOnly_chat_mcp_allowManagedServersOnly_policy">Use only the enterprise-managed MCP allowlist when deciding which servers may run.</string>
			<string id="ChatApprovedAccountOrganizations">ChatApprovedAccountOrganizations</string>
			<string id="ChatApprovedAccountOrganizations_chat_approvedAccountOrganizations_policy_description">Bu ilkeyi boş olmayan bir listeye ayarlamak, Onaylı Hesap geçidini etkinleştirir: Kullanıcı, kuruluşları bu listeyle kesişen bir GitHub hesabında oturum açana VE hesap tarafı ilke verileri çözümlenene kadar tüm yapay zeka özellikleri devre dışı kalır. Karşılaştırma büyük/küçük harfe duyarsızdır. Oturum açmış herhangi bir GitHub veya GHE hesabını kabul etmek üzere joker karakter olarak '*' kullanın (kuruluş listesinin görünür olmadığı yerlerde GHE dağıtımları için bunu kullanın).</string>
			<string id="ChatDefaultModel">ChatDefaultModel</string>
			<string id="ChatDefaultModel_chat_defaultModel_policy">Yeni konuşmalar için varsayılan sohbet modelini ayarlar. "auto", bir model aile adı ("opus" veya "gemini" gibi) ya da tam bir model kimliği kabul eder. Kullanıcılar konuşma içinde modeli yine de değiştirebilir.</string>
			<string id="ChatDeniedMcpServers">ChatDeniedMcpServers</string>
			<string id="ChatDeniedMcpServers_chat_mcp_deniedServers_policy">Denylist of Model Context Protocol servers. Servers matching any entry are blocked from being installed or run, even if they also match the allow list; deny rules always take precedence.</string>
			<string id="ChatEditorPreferCopilotHarness">ChatEditorPreferCopilotHarness</string>
			<string id="ChatEditorPreferCopilotHarness_chat_editor_preferCopilotHarness_policy">Configure whether VS Code uses the Agent Host Copilot SDK instead of the local harness for new editor chat sessions.</string>
			<string id="ChatEnabledPlugins">ChatEnabledPlugins</string>
			<string id="ChatEnabledPlugins_chat_plugins_enabledPlugins_policy">Eklenti etkinleştirme. Anahtarlar `{plugin}@{marketplace}` biçimindeki eklenti kimlikleridir; değerler eklentiyi etkinleştirir veya devre dışı bırakır.</string>
			<string id="ChatExtraMarketplaces">ChatExtraMarketplaces</string>
			<string id="ChatExtraMarketplaces_chat_plugins_extraMarketplaces_policy">Additional plugin marketplaces to query. Keys are marketplace names; values are GitHub shorthand (`owner/repo[#ref]`) or Git URIs (`{url}[#ref]`), optionally with an enterprise-managed auto-update override.</string>
			<string id="ChatHooks">ChatHooks</string>
			<string id="ChatHooks_chat_useHooks_description">Controls whether chat hooks are executed at strategic points during an agent's workflow. Hooks are loaded from the files configured in `#chat.hookFilesLocations#`. This setting is only used by the Local agent harness.</string>
			<string id="ChatMCP">ChatMCP</string>
			<string id="ChatMCP_chat_mcp_access">Yüklü Model Bağlam Protokolü sunucularına erişimi denetler.</string>
			<string id="ChatMCP_chat_mcp_access_none">MCP sunucularına erişim yok.</string>
			<string id="ChatMCP_chat_mcp_access_registry">Allows access to MCP servers listed in the registry that VS Code is connected to.</string>
			<string id="ChatMCP_chat_mcp_access_any">Tüm yüklü MCP sunucularına erişime izin ver.</string>
			<string id="ChatPluginsEnabled">ChatPluginsEnabled</string>
			<string id="ChatPluginsEnabled_chat_plugins_enabled">Sohbette aracı eklentisi tümleştirmesini etkinleştir.</string>
			<string id="ChatStrictMarketplaces">ChatStrictMarketplaces</string>
			<string id="ChatStrictMarketplaces_chat_plugins_strictMarketplaces_policy">Eklenti marketplace kaynaklarının izin verilenler listesi. Ayarlandığında, yalnızca bir girdiyle eşleşen marketplace’lere güvenilir; boş dizi tüm marketplace’leri engeller.</string>
			<string id="ChatStrictPluginOnlyCustomization">ChatStrictPluginOnlyCustomization</string>
			<string id="ChatStrictPluginOnlyCustomization_chat_customizations_strictPluginOnlyCustomization_policy">Blocks standalone user and workspace skills, agents, hooks, instructions, and MCP servers while keeping eligible plugin customizations available.</string>
			<string id="ChatToolsAutoApprove">ChatToolsAutoApprove</string>
			<string id="ChatToolsAutoApprove_autoApprove3_description">"YOLO modu" olarak da bilinen genel otomatik onaylama, tüm çalışma alanlarındaki tüm araçlar için el ile onayı tamamen devre dışı bırakır ve aracının tamamen otonom olarak hareket etmesine olanak tanır. Bu son derece tehlikelidir ve *hiçbir zaman* önerilmez; Codespaces ve Geliştirici Kapsayıcıları gibi kapsayıcılı ortamlarda bile, kapsayıcıya iletilen kullanıcı anahtarları riske girebilir.

Bu özellik, kritik güvenlik korumalarını devre dışı bırakarak bir saldırganın makineyi ele geçirmesini çok daha kolay hale getirir.

Not: Bu ayar yalnızca araç onayını denetler, aracının soru sormasını engellemez. Aracının sorularını otomatik olarak yanıtlamak için `#chat.autoReply#` ayarını kullanın.</string>
			<string id="ChatToolsEligibleForAutoApproval">ChatToolsEligibleForAutoApproval</string>
			<string id="ChatToolsEligibleForAutoApproval_chat_tools_eligibleForAutoApproval">Hangi araçların otomatik onay için uygun olduğunu denetler. ‘False’ olarak ayarlanan araçlar her zaman bir onay mesajı gösterir ve otomatik onay seçeneği sunmaz. Varsayılan davranış (veya bir aracı ‘true’ olarak ayarlamak), aracın otomatik onay seçenekleri sunmasına neden olabilir.</string>
			<string id="Claude3PIntegration">Claude3PIntegration</string>
			<string id="Claude3PIntegration_chat_agentHost_claudeAgent_enabled_policy">VS Code'da Claude Agent oturumlarını etkinleştirin. Anthropic Claude Agent SDK'sı ile desteklenen aracılı kodlama oturumlarını doğrudan düzenleyicide başlatın ve sürdürün. Mevcut Copilot aboneliğinizi kullanır.</string>
			<string id="Codex3PIntegration">Codex3PIntegration</string>
			<string id="Codex3PIntegration_chat_agentHost_codexAgent_enabled_policy">Enable Codex Agent sessions in VS Code. Start and resume agentic coding sessions powered by OpenAI Codex. Usage can be routed through GitHub Copilot or authenticated directly with an OpenAI account.</string>
			<string id="CopilotNextEditSuggestions">CopilotNextEditSuggestions</string>
			<string id="CopilotNextEditSuggestions_github_copilot_nextEditSuggestions_enabled">Whether to enable next edit suggestions (NES). NES can propose a next edit based on your recent changes.</string>
			<string id="CopilotOtelCaptureContent">CopilotOtelCaptureContent</string>
			<string id="CopilotOtelCaptureContent_chat_agentHost_otel_captureContent_policy">Copilot OpenTelemetry dışarı aktarma işleminin istem, yanıt ve araç içeriğini yakalayıp yakalamayacağını denetler.</string>
			<string id="CopilotOtelEnabled">CopilotOtelEnabled</string>
			<string id="CopilotOtelEnabled_chat_agentHost_otel_enabled_policy">Copilot OpenTelemetry dışarı aktarma işleminin etkin olup olmadığını denetler. Yönetildiğinde, kullanıcılar kurumsal değeri geçersiz kılamaz.</string>
			<string id="CopilotOtelEndpoint">CopilotOtelEndpoint</string>
			<string id="CopilotOtelEndpoint_chat_agentHost_otel_otlpEndpoint_policy">Copilot OpenTelemetry dışarı aktarma işlemi için kurumsal olarak yönetilen OTLP toplayıcı uç noktasını denetler.</string>
			<string id="CopilotOtelHeaders">CopilotOtelHeaders</string>
			<string id="CopilotOtelHeaders_chat_agentHost_otel_headers_policy">Copilot OpenTelemetry dışarı aktarma işlemi için kurumsal olarak yönetilen OTLP dışarı aktarıcıyı denetler.</string>
			<string id="CopilotOtelOtlpProtocol">CopilotOtelOtlpProtocol</string>
			<string id="CopilotOtelOtlpProtocol_chat_agentHost_otel_otlpProtocol_policy">Copilot OpenTelemetry dışarı aktarma işlemi için kurumsal olarak yönetilen OTLP kablo protokolünü denetler (protobuf - JSON).</string>
			<string id="CopilotOtelOutfile">CopilotOtelOutfile</string>
			<string id="CopilotOtelOutfile_chat_agentHost_otel_outfile_policy">Kurumsal olarak yönetilen Copilot OpenTelemetry dışarı aktarma yapılandırıldığında yerel dosya dışarı aktarmayı engeller.</string>
			<string id="CopilotOtelProtocol">CopilotOtelProtocol</string>
			<string id="CopilotOtelProtocol_chat_agentHost_otel_protocol_policy">Copilot OpenTelemetry dışarı aktarma işlemi için kurumsal olarak yönetilen OTLP protokolünü denetler.</string>
			<string id="CopilotOtelProtocol_chat_agentHost_otel_protocol_policy_otlpHttp">HTTP üzerinden OTLP kullanın.</string>
			<string id="CopilotOtelProtocol_chat_agentHost_otel_protocol_policy_otlpGrpc">gRPC üzerinden OTLP kullanın.</string>
			<string id="CopilotOtelProtocol_chat_agentHost_otel_protocol_policy_console">Konsol dışarı aktarıcı, kurumsal olarak yönetilen ayarlar tarafından seçilmedi.</string>
			<string id="CopilotOtelProtocol_chat_agentHost_otel_protocol_policy_file">Dosya dışarı aktarıcı, kurumsal olarak yönetilen ayarlar tarafından seçilmedi.</string>
			<string id="CopilotOtelResourceAttributes">CopilotOtelResourceAttributes</string>
			<string id="CopilotOtelResourceAttributes_chat_agentHost_otel_resourceAttributes_policy">Copilot OpenTelemetry dışarı aktarma işlemi için kurumsal olarak yönetilen OTel kaynağı özniteliklerini denetler.</string>
			<string id="CopilotOtelServiceName">CopilotOtelServiceName</string>
			<string id="CopilotOtelServiceName_chat_agentHost_otel_serviceName_policy">Copilot OpenTelemetry dışarı aktarma işlemi için kurumsal olarak yönetilen OTel `service.name` kaynağı özniteliklerini denetler.</string>
			<string id="CopilotReviewAgent">CopilotReviewAgent</string>
			<string id="CopilotReviewAgent_github_copilot_chat_reviewAgent_enabled">Enables the code review agent.</string>
			<string id="CopilotReviewSelection">CopilotReviewSelection</string>
			<string id="CopilotReviewSelection_github_copilot_chat_reviewSelection_enabled">Enables code review on current selection.</string>
			<string id="CopilotSessionSync">CopilotSessionSync</string>
			<string id="CopilotSessionSync_chat_sessionSync_enabled_policy">Cihazlar arası Copilot oturum geçmişi için GitHub.com oturum eşitlemeyi etkinleştirin. Kuruluş politikası tarafından devre dışı bırakıldığında, oturum verileri yalnızca yerel olarak tutulur.</string>
			<string id="DictationEnabled">DictationEnabled</string>
			<string id="DictationEnabled_dictation_enabled_policy">Controls whether dictation is available across the product (chat input, editor, and terminal).</string>
			<string id="DictationLLMCleanup">DictationLLMCleanup</string>
			<string id="DictationLLMCleanup_dictation_experimental_llmCleanup_policy">Controls whether final dictation transcripts are sent to a language model for cleanup.</string>
			<string id="DictationModel">DictationModel</string>
			<string id="DictationModel_dictation_model_policy">Controls the transcription model used for dictation.</string>
			<string id="DictationModel_dictation_model_nemotronMultilingual_policy">Use the on-device transcription model. Audio does not leave the device.</string>
			<string id="DictationModel_dictation_model_mai_policy">Use the cloud transcription service. Audio is streamed to the service.</string>
			<string id="McpEnterpriseManagedAuthIdp">McpEnterpriseManagedAuthIdp</string>
			<string id="McpEnterpriseManagedAuthIdp_mcp_enterpriseManagedAuth_idp_policy">Kurumsal olarak yönetilen Model Bağlam Protokolü (MCP) sunucusu kimlik doğrulaması için kullanılan OAuth/OIDC IdP yapılandırması.</string>
			<string id="McpGalleryServiceUrl">McpGalleryServiceUrl</string>
			<string id="McpGalleryServiceUrl_mcp_gallery_serviceUrl">MCP Galeri hizmeti URL'sini şuna bağlanacak şekilde yapılandır</string>
			<string id="AllowedExtensions">AllowedExtensions</string>
			<string id="AllowedExtensions_extensions_allowed_policy">Kullanılmasına izin verilen uzantıların bir listesini belirtin. Bu, yetkisiz uzantıların kullanımını kısıtlayarak güvenli ve tutarlı bir geliştirme ortamının korunmasına yardımcı olur. Daha fazla bilgi: https://aka.ms/vscode/enterprise/extensions/allowed</string>
			<string id="ExtensionGalleryAuthProvider">ExtensionGalleryAuthProvider</string>
			<string id="ExtensionGalleryAuthProvider_extensions_gallery_authProvider">Configure the authentication provider for the Extensions Marketplace</string>
			<string id="ExtensionGalleryAuthProvider_extensions_gallery_authProvider_github">Authenticate to the Extensions Marketplace using GitHub.</string>
			<string id="ExtensionGalleryAuthProvider_extensions_gallery_authProvider_microsoft">Authenticate to the Extensions Marketplace using a Microsoft (Entra ID) account.</string>
			<string id="ExtensionGalleryServiceUrl">ExtensionGalleryServiceUrl</string>
			<string id="ExtensionGalleryServiceUrl_extensions_gallery_serviceUrl">Şuraya bağlanmak için Market hizmeti URL'sini yapılandır</string>
			<string id="ExtensionsAutoUpdate">ExtensionsAutoUpdate</string>
			<string id="ExtensionsAutoUpdate_extensions_autoUpdate">Uzantıların otomatik güncelleştirme davranışını denetler. Güncelleştirmeler, bir Microsoft çevrimiçi hizmetinden getirilir.</string>
			<string id="ExtensionsAutoUpdate_extensions_autoUpdate_on">Yalnızca etkin uzantılar için güncelleştirmeleri otomatik olarak indirin ve yükleyin.</string>
			<string id="ExtensionsAutoUpdate_extensions_autoUpdate_off">Uzantılar otomatik olarak güncelleştirilmiyor.</string>
			<string id="ExtensionsAutoUpdateDelay">ExtensionsAutoUpdateDelay</string>
			<string id="ExtensionsAutoUpdateDelay_extensions_autoUpdateDelay">Bir uzantı güncelleştirmesi yayımlandıktan sonra, otomatik olarak yüklenmeden önce saat cinsinden gecikmeyi denetler. Yalnızca `#extensions.autoUpdate#` `on` olarak ayarlandığında geçerlidir. Bu gecikme, yayımlandıktan hemen sonra olası sorunlu güncelleştirmelerin yüklenmesini önlemeye yardımcı olur.</string>
			<string id="ChatAgentSandboxAllowAutoApprove">ChatAgentSandboxAllowAutoApprove</string>
			<string id="ChatAgentSandboxAllowAutoApprove_agentSandbox_allowAutoApprove">Korumalı alan içinde çalışan aracı modu terminal komutlarının otomatik olarak onaylanıp onaylanmayacağını denetler. Devre dışı bırakıldığında terminalde çalıştır aracı mevcut onay akışını kullanır. Bu, yalnızca {0} etkinleştirildiğinde geçerlidir.</string>
			<string id="ChatAgentSandboxAllowNetwork">ChatAgentSandboxAllowNetwork</string>
			<string id="ChatAgentSandboxAllowNetwork_agentSandbox_allowNetwork">{0} etkinleştirildiğinde, korumalı alanda tüm ağ etki alanlarına izin verilip verilmeyeceğini denetler. Etkinleştirildiğinde, korumalı alan dosya sistemi kısıtlamalarını korurken tüm ağ kısıtlamalarını gevşetir.</string>
			<string id="ChatAgentSandboxAllowUnsandboxedCommands">ChatAgentSandboxAllowUnsandboxedCommands</string>
			<string id="ChatAgentSandboxAllowUnsandboxedCommands_agentSandbox_allowUnsandboxedCommands">Korumalı bir komut başarısız olduğunda veya korumalı alan kısıtlamaları komutu engellediğinde, kullanıcı onayından sonra aracı modu terminal komutlarının korumalı alan dışında çalışıp çalışamayacağını denetler. Bu, yalnızca {0} etkinleştirildiğinde geçerlidir.</string>
			<string id="ChatAgentSandboxEnabled">ChatAgentSandboxEnabled</string>
			<string id="ChatAgentSandboxEnabled_agentSandbox_enabledSetting">Aracı modunun, araçların yapabileceklerini kısıtlamak için korumalı alan kullanıp kullanmayacağını denetler. Etkinleştirildiğinde, terminal gibi araçlar sistem erişimini sınırlamak için korumalı bir ortamda çalıştırılır. Tüm ağ etki alanlarına izin vermek için {0} kullanın.</string>
			<string id="ChatAgentSandboxEnabled_agentSandbox_enabledSetting_offDescription">Aracı modu araçları için korumalı alanı devre dışı bırakın.</string>
			<string id="ChatAgentSandboxEnabled_agentSandbox_enabledSetting_onDescription">Aracı modu araçları için korumalı alanı etkinleştirin.</string>
			<string id="ChatToolsTerminalEnableAutoApprove">ChatToolsTerminalEnableAutoApprove</string>
			<string id="ChatToolsTerminalEnableAutoApprove_autoApproveMode_description">Terminal aracında çalıştırmada otomatik onaya izin verilip verilmeyeceğini denetler.</string>
			<string id="EnableFeedback">EnableFeedback</string>
			<string id="EnableFeedback_telemetry_feedback_enabled">Sorun bildirici, anketler ve diğer geri bildirim seçenekleri gibi geri bildirim mekanizmalarını etkinleştirin.</string>
			<string id="TelemetryLevel">TelemetryLevel</string>
			<string id="TelemetryLevel_telemetry_telemetryLevel_policyDescription">Telemetri düzeyini kontrol eder.</string>
			<string id="TelemetryLevel_telemetry_telemetryLevel_default">Kullanım verilerini, hataları ve kilitlenme raporlarını gönderir.</string>
			<string id="TelemetryLevel_telemetry_telemetryLevel_error">Genel hata telemetrisini ve kilitlenme raporlarını gönderir.</string>
			<string id="TelemetryLevel_telemetry_telemetryLevel_crash">İşletim sistemi düzeyi kilitlenme raporlarını gönderir.</string>
			<string id="TelemetryLevel_telemetry_telemetryLevel_off">Tüm ürün telemetrisini devre dışı bırakır.</string>
			<string id="UpdateMode">UpdateMode</string>
			<string id="UpdateMode_updateMode">Otomatik güncelleştirmeleri alıp almayacağınızı yapılandırın. Güncelleştirmeler, bir Microsoft çevrimiçi hizmetinden getirilir.</string>
			<string id="UpdateMode_none">Yok</string>
			<string id="UpdateMode_manual">Otomatik arka plan güncelleştirme denetimlerini devre dışı bırak. El ile denetlerseniz güncelleştirmeler kullanılabilir.</string>
			<string id="UpdateMode_start">Başlat</string>
			<string id="UpdateMode_default">Sistem</string>
		</stringTable>
		<presentationTable>
