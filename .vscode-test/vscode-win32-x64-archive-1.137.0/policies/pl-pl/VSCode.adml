			<string id="Category_interactiveSessionConfigurationTitle">Sesja interakcyjna</string>
			<string id="Category_extensionsConfigurationTitle">Rozszerzenia</string>
			<string id="Category_terminalIntegratedConfigurationTitle">Zintegrowany terminal</string>
			<string id="Category_telemetryConfigurationTitle">Telemetria</string>
			<string id="Category_updateConfigurationTitle">Aktualizuj</string>
			<string id="AgentsVoice">AgentsVoice</string>
			<string id="AgentsVoice_agents_voice_enabled">Włącz panel Tryb głosowy w widoku czatu na potrzeby konwersacji kodowania głosowego.</string>
			<string id="BrowserChatTools">BrowserChatTools</string>
			<string id="BrowserChatTools_browser_enableChatTools">Po włączeniu tej opcji agenci czatu mogą używać narzędzi przeglądarki do otwierania stron i interakcji z nimi w zintegrowanej przeglądarce.</string>
			<string id="ChatAgentAllowedNetworkDomains">ChatAgentAllowedNetworkDomains</string>
			<string id="ChatAgentAllowedNetworkDomains_chat_agent_allowedNetworkDomains">Dozwolone domeny dla dostępu do sieci przez narzędzia agenta (narzędzie do pobierania, zintegrowana przeglądarka). Działa tylko, gdy włączono {0} lub {1}. Po {2} włączeniu wszystkie domeny są dozwolone. Obsługuje symbole wieloznaczne, takie jak {3}. Gdy zarówno lista dozwolonych, jak i lista zablokowanych domen są puste, wszystkie domeny są blokowane. Domeny zablokowane (zobacz {4}) mają pierwszeństwo.</string>
			<string id="ChatAgentDeniedNetworkDomains">ChatAgentDeniedNetworkDomains</string>
			<string id="ChatAgentDeniedNetworkDomains_chat_agent_deniedNetworkDomains">Odmowa domen dostępu do sieci przez narzędzia agenta (narzędzie do pobierania, zintegrowana przeglądarka). Działa tylko, gdy włączono {0} lub {1}. Nie dotyczy, gdy wartość elementu {2} jest włączona. Ma pierwszeństwo przed {3}. Obsługuje symbole wieloznaczne, takie jak {4}.</string>
			<string id="ChatAgentExtensionTools">ChatAgentExtensionTools</string>
			<string id="ChatAgentExtensionTools_chat_extensionToolsEnabled">Włącz korzystanie z narzędzi dostarczonych przez rozszerzenia innych firm.</string>
			<string id="ChatAgentHostCustomTerminalTool">ChatAgentHostCustomTerminalTool</string>
			<string id="ChatAgentHostCustomTerminalTool_chat_agentHost_customTerminalTool_enabled_policy">Enable the Agent Host custom terminal tool override for Copilot SDK sessions.</string>
			<string id="ChatAgentMode">ChatAgentMode</string>
			<string id="ChatAgentMode_chat_agent_enabled_description">Po włączeniu tryb agenta można aktywować z poziomu czatu, a narzędzia w kontekstach agentowych z efektami ubocznymi mogą być używane.</string>
			<string id="ChatAgentNetworkFilter">ChatAgentNetworkFilter</string>
			<string id="ChatAgentNetworkFilter_chat_agent_networkFilter">Po włączeniu dostęp do sieci przez narzędzia agenta (narzędzie do pobierania, zintegrowana przeglądarka) jest ograniczony zgodnie z {0} i {1}. Filtrowanie domen jest też stosowane do tych narzędzi, gdy {2} jest włączone.</string>
			<string id="ChatAllowedMcpServers">ChatAllowedMcpServers</string>
			<string id="ChatAllowedMcpServers_chat_mcp_allowedServers_policy">Allowlist of Model Context Protocol servers. When set, only servers matching an entry may be installed or run; omit entirely to allow all servers (subject to the deny list).</string>
			<string id="ChatAllowManagedHooksOnly">ChatAllowManagedHooksOnly</string>
			<string id="ChatAllowManagedHooksOnly_chat_hooks_allowManagedOnly_policy">Allows hooks only from enterprise-managed sources and plugins force-enabled by policy.</string>
			<string id="ChatAllowManagedMcpServersOnly">ChatAllowManagedMcpServersOnly</string>
			<string id="ChatAllowManagedMcpServersOnly_chat_mcp_allowManagedServersOnly_policy">Use only the enterprise-managed MCP allowlist when deciding which servers may run.</string>
			<string id="ChatApprovedAccountOrganizations">ChatApprovedAccountOrganizations</string>
			<string id="ChatApprovedAccountOrganizations_chat_approvedAccountOrganizations_policy_description">Ustawienie tych zasad na listę zawierającą co najmniej jeden wpis powoduje aktywację mechanizmu „zatwierdzonych kont”: wszystkie funkcje AI są wyłączone do momentu, gdy użytkownik zaloguje się na konto w serwisie GitHub, którego organizacje pokrywają się z tą listą ORAZ dane dotyczące zasad po stronie konta zostaną zweryfikowane. W porównaniu nie jest uwzględniana wielkość liter. Użyj znaku „*” jako symbolu wieloznacznego, aby zaakceptować dowolne zalogowane konto w serwisie GitHub lub GHE (użyj tej opcji w przypadku wdrożeń w GHE, gdzie lista organizacji nie jest widoczna).</string>
			<string id="ChatDefaultModel">ChatDefaultModel</string>
			<string id="ChatDefaultModel_chat_defaultModel_policy">Ustawia domyślny model czatu dla nowych konwersacji. Akceptuje wartość „auto”, nazwę rodziny modeli (np. „opus” lub „gemini”) albo pełny identyfikator modelu. Użytkownicy nadal mogą przełączać model w konwersacji.</string>
			<string id="ChatDeniedMcpServers">ChatDeniedMcpServers</string>
			<string id="ChatDeniedMcpServers_chat_mcp_deniedServers_policy">Denylist of Model Context Protocol servers. Servers matching any entry are blocked from being installed or run, even if they also match the allow list; deny rules always take precedence.</string>
			<string id="ChatEditorPreferCopilotHarness">ChatEditorPreferCopilotHarness</string>
			<string id="ChatEditorPreferCopilotHarness_chat_editor_preferCopilotHarness_policy">Configure whether VS Code uses the Agent Host Copilot SDK instead of the local harness for new editor chat sessions.</string>
			<string id="ChatEnabledPlugins">ChatEnabledPlugins</string>
			<string id="ChatEnabledPlugins_chat_plugins_enabledPlugins_policy">Włączanie wtyczki. Klucze to identyfikatory wtyczek w formacie `{plugin}@{marketplace}`, a wartości włączają lub wyłączają wtyczkę.</string>
			<string id="ChatExtraMarketplaces">ChatExtraMarketplaces</string>
			<string id="ChatExtraMarketplaces_chat_plugins_extraMarketplaces_policy">Additional plugin marketplaces to query. Keys are marketplace names; values are GitHub shorthand (`owner/repo[#ref]`) or Git URIs (`{url}[#ref]`), optionally with an enterprise-managed auto-update override.</string>
			<string id="ChatHooks">ChatHooks</string>
			<string id="ChatHooks_chat_useHooks_description">Controls whether chat hooks are executed at strategic points during an agent's workflow. Hooks are loaded from the files configured in `#chat.hookFilesLocations#`. This setting is only used by the Local agent harness.</string>
			<string id="ChatMCP">ChatMCP</string>
			<string id="ChatMCP_chat_mcp_access">Steruje dostępem do zainstalowanych serwerów protokołu kontekstowego modelu.</string>
			<string id="ChatMCP_chat_mcp_access_none">Brak dostępu do serwerów MCP.</string>
			<string id="ChatMCP_chat_mcp_access_registry">Allows access to MCP servers listed in the registry that VS Code is connected to.</string>
			<string id="ChatMCP_chat_mcp_access_any">Zezwalaj na dostęp do dowolnego zainstalowanego serwera MCP.</string>
			<string id="ChatPluginsEnabled">ChatPluginsEnabled</string>
			<string id="ChatPluginsEnabled_chat_plugins_enabled">Włącz integrację wtyczki agenta na czacie.</string>
			<string id="ChatStrictMarketplaces">ChatStrictMarketplaces</string>
			<string id="ChatStrictMarketplaces_chat_plugins_strictMarketplaces_policy">Lista dozwolonych źródeł dla platformy handlowej wtyczek. Po ustawieniu zaufane są tylko platformy handlowe zgodne z wpisem; pusta tablica blokuje wszystkie platformy handlowe.</string>
			<string id="ChatStrictPluginOnlyCustomization">ChatStrictPluginOnlyCustomization</string>
			<string id="ChatStrictPluginOnlyCustomization_chat_customizations_strictPluginOnlyCustomization_policy">Blocks standalone user and workspace skills, agents, hooks, instructions, and MCP servers while keeping eligible plugin customizations available.</string>
			<string id="ChatToolsAutoApprove">ChatToolsAutoApprove</string>
			<string id="ChatToolsAutoApprove_autoApprove3_description">Globalne automatyczne zatwierdzanie nazywane również „trybem YOLO” powoduje całkowite wyłączenie ręcznego zatwierdzania dla wszystkich narzędzi we wszystkich obszarach roboczych, co pozwala agentowi działać w pełni autonomicznie. Jest to bardzo niebezpieczne i *nigdy* nie jest rekomendowane, nawet w środowiskach konteneryzowanych, takich jak Codespaces i kontenery deweloperskie, klucze użytkownika są przekazywane do kontenera, który może zostać naruszony.

Ta funkcja wyłącza krytyczne zabezpieczenia i znacznie ułatwia osobie atakującej naruszenie zabezpieczeń maszyny.

Uwaga: to ustawienie steruje tylko zatwierdzaniem narzędzi i nie uniemożliwia agentowi zadawania pytań. Aby automatycznie odpowiadać na pytania agenta, użyj tego ustawienia `#chat.autoReply#`.</string>
			<string id="ChatToolsEligibleForAutoApproval">ChatToolsEligibleForAutoApproval</string>
			<string id="ChatToolsEligibleForAutoApproval_chat_tools_eligibleForAutoApproval">Określa, które narzędzia kwalifikują się do automatycznego zatwierdzania. Narzędzia ustawione na wartość „false” zawsze będą przedstawiać potwierdzenie i nigdy nie będą oferować opcji automatycznego zatwierdzania. Domyślne zachowanie (lub ustawienie narzędzia na wartość „true”) może spowodować, że narzędzie będzie oferować opcje automatycznego zatwierdzania.</string>
			<string id="Claude3PIntegration">Claude3PIntegration</string>
			<string id="Claude3PIntegration_chat_agentHost_claudeAgent_enabled_policy">Włącz sesje agenta Claude w VS Code. Rozpoczynaj i wznawiaj sesje kodowania z wykorzystaniem agenta, oparte na bibliotece Anthropic Claude Agent SDK, bezpośrednio w edytorze. Korzysta z Twojej istniejącej subskrypcji funkcji Copilot.</string>
			<string id="Codex3PIntegration">Codex3PIntegration</string>
			<string id="Codex3PIntegration_chat_agentHost_codexAgent_enabled_policy">Enable Codex Agent sessions in VS Code. Start and resume agentic coding sessions powered by OpenAI Codex. Usage can be routed through GitHub Copilot or authenticated directly with an OpenAI account.</string>
			<string id="CopilotNextEditSuggestions">CopilotNextEditSuggestions</string>
			<string id="CopilotNextEditSuggestions_github_copilot_nextEditSuggestions_enabled">Whether to enable next edit suggestions (NES). NES can propose a next edit based on your recent changes.</string>
			<string id="CopilotOtelCaptureContent">CopilotOtelCaptureContent</string>
			<string id="CopilotOtelCaptureContent_chat_agentHost_otel_captureContent_policy">Określa, czy eksport funkcji Copilot OpenTelemetry przechwytuje polecenie, odpowiedź i zawartość narzędzia.</string>
			<string id="CopilotOtelEnabled">CopilotOtelEnabled</string>
			<string id="CopilotOtelEnabled_chat_agentHost_otel_enabled_policy">Określa, czy eksportowanie funkcji Copilot OpenTelemetry jest włączone. W przypadku zarządzania użytkownicy nie mogą przesłonić wartości przedsiębiorstwa.</string>
			<string id="CopilotOtelEndpoint">CopilotOtelEndpoint</string>
			<string id="CopilotOtelEndpoint_chat_agentHost_otel_otlpEndpoint_policy">Steruje punktem końcowym modułu zbierającego OTLP zarządzanym przez przedsiębiorstwo na potrzeby eksportu funkcji Copilot OpenTelemetry.</string>
			<string id="CopilotOtelHeaders">CopilotOtelHeaders</string>
			<string id="CopilotOtelHeaders_chat_agentHost_otel_headers_policy">Kontroluje nagłówki eksportera OTLP zarządzanego przez przedsiębiorstwo w ramach eksportu Copilot OpenTelemetry.</string>
			<string id="CopilotOtelOtlpProtocol">CopilotOtelOtlpProtocol</string>
			<string id="CopilotOtelOtlpProtocol_chat_agentHost_otel_otlpProtocol_policy">Steruje protokołem sieciowym OTLP zarządzanym na poziomie przedsiębiorstwa (protobuf vs JSON) w celu eksportu danych do funkcji Copilot OpenTelemetry.</string>
			<string id="CopilotOtelOutfile">CopilotOtelOutfile</string>
			<string id="CopilotOtelOutfile_chat_agentHost_otel_outfile_policy">Uniemożliwia eksport plików lokalnych, gdy skonfigurowano eksport Copilot OpenTelemetry zarządzany na poziomie przedsiębiorstwa.</string>
			<string id="CopilotOtelProtocol">CopilotOtelProtocol</string>
			<string id="CopilotOtelProtocol_chat_agentHost_otel_protocol_policy">Steruje protokołem OTLP zarządzanym przez przedsiębiorstwo na potrzeby eksportu funkcji Copilot OpenTelemetry.</string>
			<string id="CopilotOtelProtocol_chat_agentHost_otel_protocol_policy_otlpHttp">Użyj protokołu OTLP przez HTTP.</string>
			<string id="CopilotOtelProtocol_chat_agentHost_otel_protocol_policy_otlpGrpc">Używaj protokołu OTLP przez gRPC.</string>
			<string id="CopilotOtelProtocol_chat_agentHost_otel_protocol_policy_console">Podmiot przekazujący konsole nie jest wybierany przez ustawienia zarządzane przez przedsiębiorstwo.</string>
			<string id="CopilotOtelProtocol_chat_agentHost_otel_protocol_policy_file">Podmiot przekazujący pliki nie jest wybierany przez ustawienia zarządzane przez przedsiębiorstwo.</string>
			<string id="CopilotOtelResourceAttributes">CopilotOtelResourceAttributes</string>
			<string id="CopilotOtelResourceAttributes_chat_agentHost_otel_resourceAttributes_policy">Steruje atrybutami zasobów OTel zarządzanymi przez przedsiębiorstwo na potrzeby eksportu funkcji Copilot OpenTelemetry.</string>
			<string id="CopilotOtelServiceName">CopilotOtelServiceName</string>
			<string id="CopilotOtelServiceName_chat_agentHost_otel_serviceName_policy">Kontroluje atrybut zasobu `service.name` w OTel zarządzanym przez przedsiębiorstwo na potrzeby eksportu danych do usługi Copilot OpenTelemetry.</string>
			<string id="CopilotReviewAgent">CopilotReviewAgent</string>
			<string id="CopilotReviewAgent_github_copilot_chat_reviewAgent_enabled">Enables the code review agent.</string>
			<string id="CopilotReviewSelection">CopilotReviewSelection</string>
			<string id="CopilotReviewSelection_github_copilot_chat_reviewSelection_enabled">Enables code review on current selection.</string>
			<string id="CopilotSessionSync">CopilotSessionSync</string>
			<string id="CopilotSessionSync_chat_sessionSync_enabled_policy">Włącz synchronizację sesji z GitHub.com, aby korzystać z historii sesji Copilot na różnych urządzeniach. Jeśli zgodnie z zasadami organizacji ta opcja zostanie wyłączona, dane sesji będą przechowywane tylko lokalnie.</string>
			<string id="DictationEnabled">DictationEnabled</string>
			<string id="DictationEnabled_dictation_enabled_policy">Controls whether dictation is available across the product (chat input, editor, and terminal).</string>
			<string id="DictationLLMCleanup">DictationLLMCleanup</string>
			<string id="DictationLLMCleanup_dictation_experimental_llmCleanup_policy">Controls whether final dictation transcripts are sent to a language model for cleanup.</string>
			<string id="DictationModel">DictationModel</string>
			<string id="DictationModel_dictation_model_policy">Controls the transcription model used for dictation.</string>
			<string id="DictationModel_dictation_model_nemotronMultilingual_policy">Use the on-device transcription model. Audio does not leave the device.</string>
			<string id="DictationModel_dictation_model_mai_policy">Use the cloud transcription service. Audio is streamed to the service.</string>
			<string id="McpEnterpriseManagedAuthIdp">McpEnterpriseManagedAuthIdp</string>
			<string id="McpEnterpriseManagedAuthIdp_mcp_enterpriseManagedAuth_idp_policy">Konfiguracja protokołu IdP protokołu OAuth/OIDC używana do uwierzytelniania serwera zarządzanego przez przedsiębiorstwo protokołu MCP (Model Context Protocol).</string>
			<string id="McpGalleryServiceUrl">McpGalleryServiceUrl</string>
			<string id="McpGalleryServiceUrl_mcp_gallery_serviceUrl">Skonfiguruj adres URL usługi MCP Gallery, aby nawiązać połączenie z</string>
			<string id="AllowedExtensions">AllowedExtensions</string>
			<string id="AllowedExtensions_extensions_allowed_policy">Określ listę rozszerzeń, które mogą być używane. Pomaga to zachować bezpieczne i spójne środowisko programistyczne, ograniczając użycie nieautoryzowanych rozszerzeń. Więcej informacji: https://aka.ms/vscode/enterprise/extensions/allowed</string>
			<string id="ExtensionGalleryAuthProvider">ExtensionGalleryAuthProvider</string>
			<string id="ExtensionGalleryAuthProvider_extensions_gallery_authProvider">Configure the authentication provider for the Extensions Marketplace</string>
			<string id="ExtensionGalleryAuthProvider_extensions_gallery_authProvider_github">Authenticate to the Extensions Marketplace using GitHub.</string>
			<string id="ExtensionGalleryAuthProvider_extensions_gallery_authProvider_microsoft">Authenticate to the Extensions Marketplace using a Microsoft (Entra ID) account.</string>
			<string id="ExtensionGalleryServiceUrl">ExtensionGalleryServiceUrl</string>
			<string id="ExtensionGalleryServiceUrl_extensions_gallery_serviceUrl">Konfigurowanie adresu URL usługi Marketplace w celu nawiązania połączenia z</string>
			<string id="ExtensionsAutoUpdate">ExtensionsAutoUpdate</string>
			<string id="ExtensionsAutoUpdate_extensions_autoUpdate">Steruje działaniem automatycznej aktualizacji rozszerzeń. Aktualizacje są pobierane z usługi online firmy Microsoft.</string>
			<string id="ExtensionsAutoUpdate_extensions_autoUpdate_on">Automatycznie pobieraj i instaluj aktualizacje tylko dla wybranych rozszerzeń.</string>
			<string id="ExtensionsAutoUpdate_extensions_autoUpdate_off">Rozszerzenia nie są automatycznie aktualizowane.</string>
			<string id="ExtensionsAutoUpdateDelay">ExtensionsAutoUpdateDelay</string>
			<string id="ExtensionsAutoUpdateDelay_extensions_autoUpdateDelay">Steruje opóźnieniem w godzinach po opublikowaniu aktualizacji rozszerzenia przed jej automatycznym zainstalowaniem. Ma zastosowanie tylko wtedy, gdy `#extensions.autoUpdate#` jest ustawiona na wartość `on`. To opóźnienie pomaga uniknąć instalowania potencjalnie problematycznych aktualizacji natychmiast po publikacji.</string>
			<string id="ChatAgentSandboxAllowAutoApprove">ChatAgentSandboxAllowAutoApprove</string>
			<string id="ChatAgentSandboxAllowAutoApprove_agentSandbox_allowAutoApprove">Określa, czy polecenia terminalu w trybie agenta uruchamiane w piaskownicy są automatycznie zatwierdzane. Gdy ta opcja jest wyłączona, narzędzie uruchamiania w terminalu używa istniejącego przepływu zatwierdzania. Dotyczy to tylko sytuacji, gdy {0} jest włączony.</string>
			<string id="ChatAgentSandboxAllowNetwork">ChatAgentSandboxAllowNetwork</string>
			<string id="ChatAgentSandboxAllowNetwork_agentSandbox_allowNetwork">Gdy {0} opcja jest włączona, określa, czy zezwalać na wszystkie domeny sieciowe w piaskownicy. Po włączeniu piaskownica zachowuje ograniczenia systemu plików przy jednoczesnym ograniczeniu wszystkich ograniczeń sieciowych.</string>
			<string id="ChatAgentSandboxAllowUnsandboxedCommands">ChatAgentSandboxAllowUnsandboxedCommands</string>
			<string id="ChatAgentSandboxAllowUnsandboxedCommands_agentSandbox_allowUnsandboxedCommands">Określa, czy polecenia terminalu w trybie agenta mogą być uruchamiane poza piaskownicą po potwierdzeniu przez użytkownika, gdy polecenie w piaskownicy zakończy się niepowodzeniem lub gdy ograniczenia piaskownicy zablokują polecenie. Dotyczy to tylko sytuacji, gdy {0} jest włączony.</string>
			<string id="ChatAgentSandboxEnabled">ChatAgentSandboxEnabled</string>
			<string id="ChatAgentSandboxEnabled_agentSandbox_enabledSetting">Określa, czy tryb agenta używa piaskownicy, aby ograniczyć możliwości narzędzi. Po włączeniu narzędzia, takie jak terminal, są uruchamiane w środowisku w trybie piaskownicy w celu ograniczenia dostępu do systemu. Służy {0} do zezwalania na wszystkie domeny sieciowe.</string>
			<string id="ChatAgentSandboxEnabled_agentSandbox_enabledSetting_offDescription">Wyłącz piaskownicę dla narzędzi trybu agenta.</string>
			<string id="ChatAgentSandboxEnabled_agentSandbox_enabledSetting_onDescription">Włącz piaskownicę dla narzędzi trybu agenta.</string>
			<string id="ChatToolsTerminalEnableAutoApprove">ChatToolsTerminalEnableAutoApprove</string>
			<string id="ChatToolsTerminalEnableAutoApprove_autoApproveMode_description">Określa, czy zezwalać na automatyczne zatwierdzanie w narzędziu uruchamiania w terminalu.</string>
			<string id="EnableFeedback">EnableFeedback</string>
			<string id="EnableFeedback_telemetry_feedback_enabled">Włącz mechanizmy opinii, takie jak reporter problemu, ankiety i inne opcje opinii.</string>
			<string id="TelemetryLevel">TelemetryLevel</string>
			<string id="TelemetryLevel_telemetry_telemetryLevel_policyDescription">Steruje poziomem telemetrii.</string>
			<string id="TelemetryLevel_telemetry_telemetryLevel_default">Wysyła dane użycia, błędy i raporty o awariach.</string>
			<string id="TelemetryLevel_telemetry_telemetryLevel_error">Wysyła ogólną telemetrię błędów i raporty o awariach.</string>
			<string id="TelemetryLevel_telemetry_telemetryLevel_crash">Wysyła raporty o awarii na poziomie systemu operacyjnego.</string>
			<string id="TelemetryLevel_telemetry_telemetryLevel_off">Wyłącza całkowicie telemetrię produktu.</string>
			<string id="UpdateMode">UpdateMode</string>
			<string id="UpdateMode_updateMode">Skonfiguruj, czy chcesz otrzymywać aktualizacje automatyczne. Aktualizacje są pobierane z usługi online firmy Microsoft.</string>
			<string id="UpdateMode_none">Brak</string>
			<string id="UpdateMode_manual">Wyłącz automatyczne sprawdzanie aktualizacji w tle. Aktualizacje będą dostępne, jeśli wyszukasz aktualizacje ręcznie.</string>
			<string id="UpdateMode_start">Uruchamianie</string>
			<string id="UpdateMode_default">System</string>
