			<string id="Category_interactiveSessionConfigurationTitle">Sessione interattiva</string>
			<string id="Category_extensionsConfigurationTitle">Estensioni</string>
			<string id="Category_terminalIntegratedConfigurationTitle">Terminale integrato</string>
			<string id="Category_telemetryConfigurationTitle">Telemetria</string>
			<string id="Category_updateConfigurationTitle">Aggiorna</string>
			<string id="AgentsVoice">AgentsVoice</string>
			<string id="AgentsVoice_agents_voice_enabled">Abilita il pannello della modalità Voce nella visualizzazione della chat per le conversazioni di codifica gestite dalla voce.</string>
			<string id="BrowserChatTools">BrowserChatTools</string>
			<string id="BrowserChatTools_browser_enableChatTools">Se l'opzione è abilitata, gli agenti di chat possono usare gli strumenti del browser per aprire e interagire con le pagine nel browser integrato.</string>
			<string id="ChatAgentAllowedNetworkDomains">ChatAgentAllowedNetworkDomains</string>
			<string id="ChatAgentAllowedNetworkDomains_chat_agent_allowedNetworkDomains">Domini consentiti per l'accesso alla rete da parte degli strumenti dell'agente (strumento di recupero, browser integrato). Si applica quando è abilitato {0} o {1}. Quando {2} è abilitato, tutti i domini sono consentiti. Supporta caratteri jolly come {3}. Se gli elenchi elementi consentiti e non consentiti sono vuoti, tutti i domini vengono bloccati. I domini non consentiti (vedi {4}) hanno la precedenza.</string>
			<string id="ChatAgentDeniedNetworkDomains">ChatAgentDeniedNetworkDomains</string>
			<string id="ChatAgentDeniedNetworkDomains_chat_agent_deniedNetworkDomains">Domini non consentiti per l'accesso alla rete da parte degli strumenti dell'agente (strumento di recupero, browser integrato). Si applica quando è abilitato {0} o {1}. Questo non si applica quando è abilitato {2}. Ha la precedenza su {3}. Supporta caratteri jolly come {4}.</string>
			<string id="ChatAgentExtensionTools">ChatAgentExtensionTools</string>
			<string id="ChatAgentExtensionTools_chat_extensionToolsEnabled">Abilita l'uso degli strumenti forniti dalle estensioni di terze parti.</string>
			<string id="ChatAgentHostCustomTerminalTool">ChatAgentHostCustomTerminalTool</string>
			<string id="ChatAgentHostCustomTerminalTool_chat_agentHost_customTerminalTool_enabled_policy">Enable the Agent Host custom terminal tool override for Copilot SDK sessions.</string>
			<string id="ChatAgentMode">ChatAgentMode</string>
			<string id="ChatAgentMode_chat_agent_enabled_description">Se è abilitata, la modalità agente può essere attivata dalla chat e possono essere usati strumenti in contesti agentici con effetti collaterali.</string>
			<string id="ChatAgentNetworkFilter">ChatAgentNetworkFilter</string>
			<string id="ChatAgentNetworkFilter_chat_agent_networkFilter">Quando questa opzione è abilitata, l'accesso alla rete da parte degli strumenti dell'agente (strumento di recupero, browser integrato) è limitato in base a {0} e {1}. I filtri di dominio vengono applicati anche a tali strumenti quando {2} è abilitato.</string>
			<string id="ChatAllowedMcpServers">ChatAllowedMcpServers</string>
			<string id="ChatAllowedMcpServers_chat_mcp_allowedServers_policy">Allowlist of Model Context Protocol servers. When set, only servers matching an entry may be installed or run; omit entirely to allow all servers (subject to the deny list).</string>
			<string id="ChatAllowManagedHooksOnly">ChatAllowManagedHooksOnly</string>
			<string id="ChatAllowManagedHooksOnly_chat_hooks_allowManagedOnly_policy">Allows hooks only from enterprise-managed sources and plugins force-enabled by policy.</string>
			<string id="ChatAllowManagedMcpServersOnly">ChatAllowManagedMcpServersOnly</string>
			<string id="ChatAllowManagedMcpServersOnly_chat_mcp_allowManagedServersOnly_policy">Use only the enterprise-managed MCP allowlist when deciding which servers may run.</string>
			<string id="ChatApprovedAccountOrganizations">ChatApprovedAccountOrganizations</string>
			<string id="ChatApprovedAccountOrganizations_chat_approvedAccountOrganizations_policy_description">L'impostazione di questo criterio su un elenco non vuoto attiva il conto degli account approvati: tutte le funzionalità di intelligenza artificiale vengono disabilitate finché l'utente non accede a un account GitHub le cui organizzazioni sono presenti in questo elenco E i dati dei criteri lato account non sono stati risolti. Il confronto non fa distinzione tra maiuscole e minuscole. Usare '*' come carattere jolly per accettare qualsiasi account GitHub o GHE connesso (usare questa opzione per le distribuzioni GHE in cui l'elenco delle organizzazioni non è visualizzato).</string>
			<string id="ChatDefaultModel">ChatDefaultModel</string>
			<string id="ChatDefaultModel_chat_defaultModel_policy">Imposta il modello di chat predefinito per le nuove conversazioni. Accetta "auto", un nome di famiglia di modelli (ad esempio "opus" o "gemini") o un ID modello completo. Gli utenti possono comunque cambiare il modello all'interno di una conversazione.</string>
			<string id="ChatDeniedMcpServers">ChatDeniedMcpServers</string>
			<string id="ChatDeniedMcpServers_chat_mcp_deniedServers_policy">Denylist of Model Context Protocol servers. Servers matching any entry are blocked from being installed or run, even if they also match the allow list; deny rules always take precedence.</string>
			<string id="ChatEditorPreferCopilotHarness">ChatEditorPreferCopilotHarness</string>
			<string id="ChatEditorPreferCopilotHarness_chat_editor_preferCopilotHarness_policy">Configure whether VS Code uses the Agent Host Copilot SDK instead of the local harness for new editor chat sessions.</string>
			<string id="ChatEnabledPlugins">ChatEnabledPlugins</string>
			<string id="ChatEnabledPlugins_chat_plugins_enabledPlugins_policy">Abilitazione del plug-in. Le chiavi sono ID di plug-in nel formato `{plugin}@{marketplace}`; i valori abilitano o disabilitano il plug-in.</string>
			<string id="ChatExtraMarketplaces">ChatExtraMarketplaces</string>
			<string id="ChatExtraMarketplaces_chat_plugins_extraMarketplaces_policy">Additional plugin marketplaces to query. Keys are marketplace names; values are GitHub shorthand (`owner/repo[#ref]`) or Git URIs (`{url}[#ref]`), optionally with an enterprise-managed auto-update override.</string>
			<string id="ChatHooks">ChatHooks</string>
			<string id="ChatHooks_chat_useHooks_description">Controls whether chat hooks are executed at strategic points during an agent's workflow. Hooks are loaded from the files configured in `#chat.hookFilesLocations#`. This setting is only used by the Local agent harness.</string>
			<string id="ChatMCP">ChatMCP</string>
			<string id="ChatMCP_chat_mcp_access">Controlla l'accesso ai server Model Context Protocol installati.</string>
			<string id="ChatMCP_chat_mcp_access_none">Nessun accesso ai server MCP.</string>
			<string id="ChatMCP_chat_mcp_access_registry">Allows access to MCP servers listed in the registry that VS Code is connected to.</string>
			<string id="ChatMCP_chat_mcp_access_any">Consenti l'accesso a qualsiasi server MCP installato.</string>
			<string id="ChatPluginsEnabled">ChatPluginsEnabled</string>
			<string id="ChatPluginsEnabled_chat_plugins_enabled">Abilitare l'integrazione del plug-in dell'agente nella chat.</string>
			<string id="ChatStrictMarketplaces">ChatStrictMarketplaces</string>
			<string id="ChatStrictMarketplaces_chat_plugins_strictMarketplaces_policy">Elenco elementi consentiti relativi alle origini del marketplace del plug-in. Se l'opzione è impostata, solo i marketplace corrispondenti a una voce sono attendibili; una matrice vuota blocca tutti i marketplace.</string>
			<string id="ChatStrictPluginOnlyCustomization">ChatStrictPluginOnlyCustomization</string>
			<string id="ChatStrictPluginOnlyCustomization_chat_customizations_strictPluginOnlyCustomization_policy">Blocks standalone user and workspace skills, agents, hooks, instructions, and MCP servers while keeping eligible plugin customizations available.</string>
			<string id="ChatToolsAutoApprove">ChatToolsAutoApprove</string>
			<string id="ChatToolsAutoApprove_autoApprove3_description">L'approvazione automatica globale, nota anche come "modalità YOLO", disabilita completamente l'approvazione manuale per tutti gli strumenti in tutte le aree di lavoro, consentendo all'agente di agire in modo totalmente autonomo. Questa condizione è estremamente pericolosa e non è *mai* consigliata, anche in ambienti in contenitori come Codespaces: nei contenitori di sviluppo, infatti, le chiavi utente vengono inoltrate nel contenitore e potrebbero essere compromesse.

Questa funzione disabilita le protezioni di sicurezza critiche e rende molto più facile per un utente malintenzionato compromettere il computer.

Nota: questa impostazione controlla solo l'approvazione dello strumento e non impedisce all'agente di porre domande. Per rispondere automaticamente alle domande dell'agente, usare l'impostazione `#chat.autoReply#`.</string>
			<string id="ChatToolsEligibleForAutoApproval">ChatToolsEligibleForAutoApproval</string>
			<string id="ChatToolsEligibleForAutoApproval_chat_tools_eligibleForAutoApproval">Controlla quali strumenti possono essere approvati automaticamente. Gli strumenti impostati su 'false' richiederanno sempre una conferma e non offriranno mai l'opzione di approvazione automatica. Il comportamento predefinito (o l'impostazione di uno strumento su 'true') può far sì che lo strumento proponga opzioni di approvazione automatica.</string>
			<string id="Claude3PIntegration">Claude3PIntegration</string>
			<string id="Claude3PIntegration_chat_agentHost_claudeAgent_enabled_policy">Abilita le sessioni di Claude Agent in VS Code. Avvia e riprendi le sessioni di coding agentico basate su Anthropic Claude Agent SDK direttamente nell'editor. Usa la sottoscrizione di Copilot esistente.</string>
			<string id="Codex3PIntegration">Codex3PIntegration</string>
			<string id="Codex3PIntegration_chat_agentHost_codexAgent_enabled_policy">Enable Codex Agent sessions in VS Code. Start and resume agentic coding sessions powered by OpenAI Codex. Usage can be routed through GitHub Copilot or authenticated directly with an OpenAI account.</string>
			<string id="CopilotNextEditSuggestions">CopilotNextEditSuggestions</string>
			<string id="CopilotNextEditSuggestions_github_copilot_nextEditSuggestions_enabled">Whether to enable next edit suggestions (NES). NES can propose a next edit based on your recent changes.</string>
			<string id="CopilotOtelCaptureContent">CopilotOtelCaptureContent</string>
			<string id="CopilotOtelCaptureContent_chat_agentHost_otel_captureContent_policy">Controlla se l'esportazione OpenTelemetry di Copilot acquisisce il contenuto di prompt, risposte e strumenti.</string>
			<string id="CopilotOtelEnabled">CopilotOtelEnabled</string>
			<string id="CopilotOtelEnabled_chat_agentHost_otel_enabled_policy">Controlla se l'esportazione di Copilot OpenTelemetry è abilitata. Se gestito, gli utenti non possono eseguire l'override del valore dell'organizzazione.</string>
			<string id="CopilotOtelEndpoint">CopilotOtelEndpoint</string>
			<string id="CopilotOtelEndpoint_chat_agentHost_otel_otlpEndpoint_policy">Controlla l'endpoint dell'agente di raccolta OTLP gestito dall'organizzazione per l'esportazione di Copilot OpenTelemetry.</string>
			<string id="CopilotOtelHeaders">CopilotOtelHeaders</string>
			<string id="CopilotOtelHeaders_chat_agentHost_otel_headers_policy">Controlla le intestazioni dell'esportatore OTLP gestite dall'organizzazione per l'esportazione OpenTelemetry di Copilot.</string>
			<string id="CopilotOtelOtlpProtocol">CopilotOtelOtlpProtocol</string>
			<string id="CopilotOtelOtlpProtocol_chat_agentHost_otel_otlpProtocol_policy">Controlla il protocollo wire OTLP gestito dall'organizzazione (protobuf o JSON) per l'esportazione OpenTelemetry di Copilot.</string>
			<string id="CopilotOtelOutfile">CopilotOtelOutfile</string>
			<string id="CopilotOtelOutfile_chat_agentHost_otel_outfile_policy">Impedisce l'esportazione locale dei file quando è configurata l'esportazione OpenTelemetry di Copilot gestita dall'organizzazione.</string>
			<string id="CopilotOtelProtocol">CopilotOtelProtocol</string>
			<string id="CopilotOtelProtocol_chat_agentHost_otel_protocol_policy">Controlla il protocollo OTLP gestito dall'organizzazione per l'esportazione OpenTelemetry di Copilot.</string>
			<string id="CopilotOtelProtocol_chat_agentHost_otel_protocol_policy_otlpHttp">Usa OTLP su HTTP.</string>
			<string id="CopilotOtelProtocol_chat_agentHost_otel_protocol_policy_otlpGrpc">Usa OTLP su gRPC.</string>
			<string id="CopilotOtelProtocol_chat_agentHost_otel_protocol_policy_console">Console exporter non selezionato dalle impostazioni gestite dall'organizzazione.</string>
			<string id="CopilotOtelProtocol_chat_agentHost_otel_protocol_policy_file">File exporter non selezionato dalle impostazioni gestite dall'organizzazione.</string>
			<string id="CopilotOtelResourceAttributes">CopilotOtelResourceAttributes</string>
			<string id="CopilotOtelResourceAttributes_chat_agentHost_otel_resourceAttributes_policy">Controlla gli attributi delle risorse OTel gestiti dall'organizzazione per l'esportazione OpenTelemetry di Copilot.</string>
			<string id="CopilotOtelServiceName">CopilotOtelServiceName</string>
			<string id="CopilotOtelServiceName_chat_agentHost_otel_serviceName_policy">Controlla l'attributo della risorsa OTel `service.name` gestito dall'organizzazione per l'esportazione OpenTelemetry di Copilot.</string>
			<string id="CopilotReviewAgent">CopilotReviewAgent</string>
			<string id="CopilotReviewAgent_github_copilot_chat_reviewAgent_enabled">Enables the code review agent.</string>
			<string id="CopilotReviewSelection">CopilotReviewSelection</string>
			<string id="CopilotReviewSelection_github_copilot_chat_reviewSelection_enabled">Enables code review on current selection.</string>
			<string id="CopilotSessionSync">CopilotSessionSync</string>
			<string id="CopilotSessionSync_chat_sessionSync_enabled_policy">Abilitare la sincronizzazione delle sessioni per GitHub.com per la cronologia delle sessioni di Copilot tra dispositivi. Se disabilitati dai criteri dell'organizzazione, i dati della sessione vengono mantenuti solo in locale.</string>
			<string id="DictationEnabled">DictationEnabled</string>
			<string id="DictationEnabled_dictation_enabled_policy">Controls whether dictation is available across the product (chat input, editor, and terminal).</string>
			<string id="DictationLLMCleanup">DictationLLMCleanup</string>
			<string id="DictationLLMCleanup_dictation_experimental_llmCleanup_policy">Controls whether final dictation transcripts are sent to a language model for cleanup.</string>
			<string id="DictationModel">DictationModel</string>
			<string id="DictationModel_dictation_model_policy">Controls the transcription model used for dictation.</string>
			<string id="DictationModel_dictation_model_nemotronMultilingual_policy">Use the on-device transcription model. Audio does not leave the device.</string>
			<string id="DictationModel_dictation_model_mai_policy">Use the cloud transcription service. Audio is streamed to the service.</string>
			<string id="McpEnterpriseManagedAuthIdp">McpEnterpriseManagedAuthIdp</string>
			<string id="McpEnterpriseManagedAuthIdp_mcp_enterpriseManagedAuth_idp_policy">Configurazione del provider di identità OAuth/OIDC usata per l'autenticazione dei server MCP (Model Context Protocol) gestiti dall'azienda.</string>
			<string id="McpGalleryServiceUrl">McpGalleryServiceUrl</string>
			<string id="McpGalleryServiceUrl_mcp_gallery_serviceUrl">Configura l'URL del servizio Galleria MCP a cui connetterti</string>
			<string id="AllowedExtensions">AllowedExtensions</string>
			<string id="AllowedExtensions_extensions_allowed_policy">Specificare un elenco di estensioni che possono essere usate. In questo modo si contribuisce a mantenere un ambiente di sviluppo sicuro e coerente, limitando l'uso di estensioni non autorizzate. Altre informazioni: https://aka.ms/vscode/enterprise/extensions/allowed</string>
			<string id="ExtensionGalleryAuthProvider">ExtensionGalleryAuthProvider</string>
			<string id="ExtensionGalleryAuthProvider_extensions_gallery_authProvider">Configure the authentication provider for the Extensions Marketplace</string>
			<string id="ExtensionGalleryAuthProvider_extensions_gallery_authProvider_github">Authenticate to the Extensions Marketplace using GitHub.</string>
			<string id="ExtensionGalleryAuthProvider_extensions_gallery_authProvider_microsoft">Authenticate to the Extensions Marketplace using a Microsoft (Entra ID) account.</string>
			<string id="ExtensionGalleryServiceUrl">ExtensionGalleryServiceUrl</string>
			<string id="ExtensionGalleryServiceUrl_extensions_gallery_serviceUrl">Configurare l'URL del servizio Marketplace a cui connettersi</string>
			<string id="ExtensionsAutoUpdate">ExtensionsAutoUpdate</string>
			<string id="ExtensionsAutoUpdate_extensions_autoUpdate">Controlla il comportamento di aggiornamento automatico delle estensioni. Gli aggiornamenti vengono recuperati da un servizio Microsoft online.</string>
			<string id="ExtensionsAutoUpdate_extensions_autoUpdate_on">Scaricare e installare automaticamente gli aggiornamenti solo per le estensioni selezionate.</string>
			<string id="ExtensionsAutoUpdate_extensions_autoUpdate_off">Le estensioni non vengono aggiornate automaticamente.</string>
			<string id="ExtensionsAutoUpdateDelay">ExtensionsAutoUpdateDelay</string>
			<string id="ExtensionsAutoUpdateDelay_extensions_autoUpdateDelay">Controlla il ritardo, in ore, tra la pubblicazione di un aggiornamento dell'estensione e la sua installazione automatica. Si applica solo quando `#extensions.autoUpdate#` è impostato su `on`. Questo ritardo serve a evitare l'installazione immediata di aggiornamenti potenzialmente problematici dopo il rilascio.</string>
			<string id="ChatAgentSandboxAllowAutoApprove">ChatAgentSandboxAllowAutoApprove</string>
			<string id="ChatAgentSandboxAllowAutoApprove_agentSandbox_allowAutoApprove">Controlla se i comandi del terminale in modalità agente eseguiti all'interno della sandbox sono approvati automaticamente. Se disabilitato, lo strumento di esecuzione nel terminale usa il flusso di approvazione esistente. Questo si applica solo quando {0} è abilitato.</string>
			<string id="ChatAgentSandboxAllowNetwork">ChatAgentSandboxAllowNetwork</string>
			<string id="ChatAgentSandboxAllowNetwork_agentSandbox_allowNetwork">Se l'opzione {0} è abilitata, determina se consentire tutti i domini di rete nella sandbox. Se abilitata, la sandbox mantiene le restrizioni del file system ma attenua tutte le restrizioni di rete.</string>
			<string id="ChatAgentSandboxAllowUnsandboxedCommands">ChatAgentSandboxAllowUnsandboxedCommands</string>
			<string id="ChatAgentSandboxAllowUnsandboxedCommands_agentSandbox_allowUnsandboxedCommands">Verifica se i comandi del terminale in modalità agente possono essere eseguiti all'esterno della sandbox, dopo la conferma dell'utente, quando un comando in modalità sandbox non riesce o quando le restrizioni della sandbox ne impedirebbero l'esecuzione. Questo si applica solo quando {0} è abilitato.</string>
			<string id="ChatAgentSandboxEnabled">ChatAgentSandboxEnabled</string>
			<string id="ChatAgentSandboxEnabled_agentSandbox_enabledSetting">Determina se la modalità agente usa il sandboxing per limitare le operazioni che gli strumenti possono eseguire. Se questa opzione è abilitata, strumenti come il terminale vengono eseguiti in un ambiente sandbox per limitare l'accesso al sistema. Usa {0} per consentire tutti i domini di rete.</string>
			<string id="ChatAgentSandboxEnabled_agentSandbox_enabledSetting_offDescription">Disbilitare la sandboxing per gli strumenti in modalità agente.</string>
			<string id="ChatAgentSandboxEnabled_agentSandbox_enabledSetting_onDescription">Abilitare la sandboxing per gli strumenti in modalità agente.</string>
			<string id="ChatToolsTerminalEnableAutoApprove">ChatToolsTerminalEnableAutoApprove</string>
			<string id="ChatToolsTerminalEnableAutoApprove_autoApproveMode_description">Controlla se consentire l'approvazione automatica nell'esecuzione dello strumento terminale.</string>
			<string id="EnableFeedback">EnableFeedback</string>
			<string id="EnableFeedback_telemetry_feedback_enabled">Abilita meccanismi di feedback come la segnalazione di problemi, i sondaggi e altre opzioni di feedback.</string>
			<string id="TelemetryLevel">TelemetryLevel</string>
			<string id="TelemetryLevel_telemetry_telemetryLevel_policyDescription">Controlla il livello di telemetria.</string>
			<string id="TelemetryLevel_telemetry_telemetryLevel_default">Invia dati di utilizzo, errori e segnalazioni di arresto anomalo.</string>
			<string id="TelemetryLevel_telemetry_telemetryLevel_error">Invia i dati di telemetria generali e le segnalazioni di arresto anomalo del sistema.</string>
			<string id="TelemetryLevel_telemetry_telemetryLevel_crash">Invia le segnalazioni di arresto anomalo a livello di sistema operativo.</string>
			<string id="TelemetryLevel_telemetry_telemetryLevel_off">Disabilita tutti i dati di telemetria del prodotto.</string>
			<string id="UpdateMode">UpdateMode</string>
			<string id="UpdateMode_updateMode">Consente di configurare la ricezione degli aggiornamenti automatici. Gli aggiornamenti vengono recuperati da un servizio online Microsoft.</string>
			<string id="UpdateMode_none">Nessuno</string>
			<string id="UpdateMode_manual">Disabilita il controllo automatico degli aggiornamenti in background. Gli aggiornamenti saranno disponibili solo se il controllo della disponibilità di aggiornamenti viene eseguito manualmente.</string>
			<string id="UpdateMode_start">Avvia</string>
			<string id="UpdateMode_default">Sistema</string>
		</stringTable>
