			<string id="AgentsVoice">AgentsVoice</string>
			<string id="AgentsVoice_agents_voice_enabled">音声主導のコーディング会話を行うため、チャットビューで音声モード パネルを有効にします。</string>
			<string id="BrowserChatTools">BrowserChatTools</string>
			<string id="BrowserChatTools_browser_enableChatTools">有効にすると、チャット エージェントはブラウザー ツールを使って統合ブラウザー内のページを開いて操作できるようになります。</string>
			<string id="ChatAgentAllowedNetworkDomains">ChatAgentAllowedNetworkDomains</string>
			<string id="ChatAgentAllowedNetworkDomains_chat_agent_allowedNetworkDomains">エージェント ツール (フェッチ ツール、統合ブラウザー) によるネットワーク アクセスが許可されているドメイン。{0} または {1} が有効になっている場合に適用されます。{2} が有効になっている場合、すべてのドメインが許可されます。{3} などのワイルドカードがサポートされます。許可と拒否のリストがどちらも空の場合は、すべてのドメインがブロックされます。拒否されたドメイン ({4} を参照) が優先されます。</string>
			<string id="ChatAgentDeniedNetworkDomains">ChatAgentDeniedNetworkDomains</string>
			<string id="ChatAgentDeniedNetworkDomains_chat_agent_deniedNetworkDomains">エージェント ツール (フェッチ ツール、統合ブラウザー) によるネットワーク アクセスが拒否されるドメイン。{0} または {1} が有効になっている場合に適用されます。これは、{2} が有効になっている場合には適用されません。{3} より優先されます。{4} などのワイルドカードがサポートされます。</string>
			<string id="ChatAgentExtensionTools">ChatAgentExtensionTools</string>
			<string id="ChatAgentExtensionTools_chat_extensionToolsEnabled">サード パーティの拡張機能によって提供されるツールの使用を有効にします。</string>
			<string id="ChatAgentHostCustomTerminalTool">ChatAgentHostCustomTerminalTool</string>
			<string id="ChatAgentHostCustomTerminalTool_chat_agentHost_customTerminalTool_enabled_policy">Enable the Agent Host custom terminal tool override for Copilot SDK sessions.</string>
			<string id="ChatAgentMode">ChatAgentMode</string>
			<string id="ChatAgentMode_chat_agent_enabled_description">有効にすると、エージェント モードをチャットからアクティブ化でき、副作用のあるエージェント コンテキストのツールを使用できます。</string>
			<string id="ChatAgentNetworkFilter">ChatAgentNetworkFilter</string>
			<string id="ChatAgentNetworkFilter_chat_agent_networkFilter">有効にすると、エージェント ツール (フェッチ ツール、統合ブラウザー) によるネットワーク アクセスは、{0} と {1} に従って制限されます。{2} が有効な場合、これらのツールにはドメイン フィルターも適用されます。</string>
			<string id="ChatAllowedMcpServers">ChatAllowedMcpServers</string>
			<string id="ChatAllowedMcpServers_chat_mcp_allowedServers_policy">Allowlist of Model Context Protocol servers. When set, only servers matching an entry may be installed or run; omit entirely to allow all servers (subject to the deny list).</string>
			<string id="ChatAllowManagedHooksOnly">ChatAllowManagedHooksOnly</string>
			<string id="ChatAllowManagedHooksOnly_chat_hooks_allowManagedOnly_policy">Allows hooks only from enterprise-managed sources and plugins force-enabled by policy.</string>
			<string id="ChatAllowManagedMcpServersOnly">ChatAllowManagedMcpServersOnly</string>
			<string id="ChatAllowManagedMcpServersOnly_chat_mcp_allowManagedServersOnly_policy">Use only the enterprise-managed MCP allowlist when deciding which servers may run.</string>
			<string id="ChatApprovedAccountOrganizations">ChatApprovedAccountOrganizations</string>
			<string id="ChatApprovedAccountOrganizations_chat_approvedAccountOrganizations_policy_description">このポリシーを空でないリストに設定すると、承認されたアカウント ゲートがアクティブになります。組織がこのリストと交差し、アカウント側のポリシー データが解決された GitHub アカウントにユーザーがサインインするまで、すべての AI 機能が無効になります。比較では大文字と小文字が区別されません。サインインしている GitHub または GHE アカウントを受け入れる場合は、ワイルドカードとして '*' を使用します (組織の一覧が表示されない GHE デプロイの場合は、これを使用します)。</string>
			<string id="ChatDefaultModel">ChatDefaultModel</string>
			<string id="ChatDefaultModel_chat_defaultModel_policy">新しい会話の既定のチャット モデルを設定します。"auto"、モデル ファミリ名 ("opus" や "gemini" など)、または完全なモデル ID を指定できます。ユーザーは会話の途中でモデルを切り替えることができます。</string>
			<string id="ChatDeniedMcpServers">ChatDeniedMcpServers</string>
			<string id="ChatDeniedMcpServers_chat_mcp_deniedServers_policy">Denylist of Model Context Protocol servers. Servers matching any entry are blocked from being installed or run, even if they also match the allow list; deny rules always take precedence.</string>
			<string id="ChatEditorPreferCopilotHarness">ChatEditorPreferCopilotHarness</string>
			<string id="ChatEditorPreferCopilotHarness_chat_editor_preferCopilotHarness_policy">Configure whether VS Code uses the Agent Host Copilot SDK instead of the local harness for new editor chat sessions.</string>
			<string id="ChatEnabledPlugins">ChatEnabledPlugins</string>
			<string id="ChatEnabledPlugins_chat_plugins_enabledPlugins_policy">プラグインの有効化。キーは `{plugin}@{marketplace}` 形式のプラグイン ID です。値は、プラグインの有効/無効を示します。</string>
			<string id="ChatExtraMarketplaces">ChatExtraMarketplaces</string>
			<string id="ChatExtraMarketplaces_chat_plugins_extraMarketplaces_policy">Additional plugin marketplaces to query. Keys are marketplace names; values are GitHub shorthand (`owner/repo[#ref]`) or Git URIs (`{url}[#ref]`), optionally with an enterprise-managed auto-update override.</string>
			<string id="ChatHooks">ChatHooks</string>
			<string id="ChatHooks_chat_useHooks_description">Controls whether chat hooks are executed at strategic points during an agent's workflow. Hooks are loaded from the files configured in `#chat.hookFilesLocations#`. This setting is only used by the Local agent harness.</string>
			<string id="ChatMCP">ChatMCP</string>
			<string id="ChatMCP_chat_mcp_access">インストールされたモデル コンテキスト プロトコル サーバーへのアクセスを制御します。</string>
			<string id="ChatMCP_chat_mcp_access_none">MCP サーバーにアクセスできません。</string>
			<string id="ChatMCP_chat_mcp_access_registry">Allows access to MCP servers listed in the registry that VS Code is connected to.</string>
			<string id="ChatMCP_chat_mcp_access_any">インストールされている任意の MCP サーバーへのアクセスを許可します。</string>
			<string id="ChatPluginsEnabled">ChatPluginsEnabled</string>
			<string id="ChatPluginsEnabled_chat_plugins_enabled">チャットでエージェント プラグインの統合を有効にします。</string>
			<string id="ChatStrictMarketplaces">ChatStrictMarketplaces</string>
			<string id="ChatStrictMarketplaces_chat_plugins_strictMarketplaces_policy">プラグイン マーケットプレース ソースの許可リスト。設定すると、エントリに一致するマーケットプレースのみが信頼されます。空の配列は、すべてのマーケットプレースをブロックします。</string>
			<string id="ChatStrictPluginOnlyCustomization">ChatStrictPluginOnlyCustomization</string>
			<string id="ChatStrictPluginOnlyCustomization_chat_customizations_strictPluginOnlyCustomization_policy">Blocks standalone user and workspace skills, agents, hooks, instructions, and MCP servers while keeping eligible plugin customizations available.</string>
			<string id="ChatToolsAutoApprove">ChatToolsAutoApprove</string>
			<string id="ChatToolsAutoApprove_autoApprove3_description">グローバル自動承認 ("YOLO モード"とも呼ばれます) は、すべてのワークスペースのすべてのツールに対する手動承認を完全に無効にし、エージェントが完全に自律的に動作できるようにします。これは非常に危険であり、*決して*推奨されません。Codespaces や開発コンテナーなどのコンテナー化された環境でも、ユーザー キーがコンテナー内に転送され、侵害される可能性があります。

この機能により、重要なセキュリティ保護が無効になり、攻撃者がマシンを侵害しやすくなります。

メモ: この設定はツールの承認のみを制御し、エージェントが質問することを防ぐものではありません。エージェントの質問に自動的に回答するには、`#chat.autoReply#` 設定を使用します。</string>
			<string id="ChatToolsEligibleForAutoApproval">ChatToolsEligibleForAutoApproval</string>
			<string id="ChatToolsEligibleForAutoApproval_chat_tools_eligibleForAutoApproval">自動承認の対象となるツールを制御します。'false' に設定されたツールには、常に確認が表示され、自動承認のオプションは提供されません。既定の動作 (またはツールを 'true' に設定すること) により、ツールで自動承認オプションが提供される場合があります。</string>
			<string id="Claude3PIntegration">Claude3PIntegration</string>
			<string id="Claude3PIntegration_chat_agentHost_claudeAgent_enabled_policy">VS Code で Claude エージェント セッションを有効にします。Anthropic の Claude エージェント SDK を使用したエージェント コーディング セッションをエディターで直接開始および再開します。既存の Copilot サブスクリプションを使用します。</string>
			<string id="Codex3PIntegration">Codex3PIntegration</string>
			<string id="Codex3PIntegration_chat_agentHost_codexAgent_enabled_policy">Enable Codex Agent sessions in VS Code. Start and resume agentic coding sessions powered by OpenAI Codex. Usage can be routed through GitHub Copilot or authenticated directly with an OpenAI account.</string>
			<string id="CopilotNextEditSuggestions">CopilotNextEditSuggestions</string>
			<string id="CopilotNextEditSuggestions_github_copilot_nextEditSuggestions_enabled">Whether to enable next edit suggestions (NES). NES can propose a next edit based on your recent changes.</string>
			<string id="CopilotOtelCaptureContent">CopilotOtelCaptureContent</string>
			<string id="CopilotOtelCaptureContent_chat_agentHost_otel_captureContent_policy">Copilot OpenTelemetry エクスポートでプロンプト、応答、およびツールのコンテンツをキャプチャするかどうかを制御します。</string>
			<string id="CopilotOtelEnabled">CopilotOtelEnabled</string>
			<string id="CopilotOtelEnabled_chat_agentHost_otel_enabled_policy">Copilot OpenTelemetry エクスポートを有効にするかどうかを制御します。管理されている場合、ユーザーはエンタープライズ値をオーバーライドできません。</string>
			<string id="CopilotOtelEndpoint">CopilotOtelEndpoint</string>
			<string id="CopilotOtelEndpoint_chat_agentHost_otel_otlpEndpoint_policy">Copilot OpenTelemetry エクスポートのエンタープライズ管理 OTLP コレクター エンドポイントを制御します。</string>
			<string id="CopilotOtelHeaders">CopilotOtelHeaders</string>
			<string id="CopilotOtelHeaders_chat_agentHost_otel_headers_policy">Copilot OpenTelemetry エクスポートのエンタープライズ管理 OTLP エクスポーター ヘッダーを制御します。</string>
			<string id="CopilotOtelOtlpProtocol">CopilotOtelOtlpProtocol</string>
			<string id="CopilotOtelOtlpProtocol_chat_agentHost_otel_otlpProtocol_policy">Copilot OpenTelemetry エクスポート用のエンタープライズ管理 OTLP ワイヤ プロトコル (protobuf と JSON) を制御します。</string>
			<string id="CopilotOtelOutfile">CopilotOtelOutfile</string>
			<string id="CopilotOtelOutfile_chat_agentHost_otel_outfile_policy">エンタープライズ管理の Copilot OpenTelemetry エクスポートが構成されている場合、ローカル ファイルのエクスポートを禁止します。</string>
			<string id="CopilotOtelProtocol">CopilotOtelProtocol</string>
			<string id="CopilotOtelProtocol_chat_agentHost_otel_protocol_policy">Copilot OpenTelemetry エクスポートのエンタープライズ管理 OTLP プロトコルを制御します。</string>
			<string id="CopilotOtelProtocol_chat_agentHost_otel_protocol_policy_otlpHttp">HTTP 経由で OTLP を使用します。</string>
			<string id="CopilotOtelProtocol_chat_agentHost_otel_protocol_policy_otlpGrpc">OTLP over gRPC を使用します。</string>
			<string id="CopilotOtelProtocol_chat_agentHost_otel_protocol_policy_console">コンソール エクスポーターは、エンタープライズ管理の設定では選択されていません。</string>
			<string id="CopilotOtelProtocol_chat_agentHost_otel_protocol_policy_file">エンタープライズ マネージド設定でファイル エクスポーターが選択されていません。</string>
			<string id="CopilotOtelResourceAttributes">CopilotOtelResourceAttributes</string>
			<string id="CopilotOtelResourceAttributes_chat_agentHost_otel_resourceAttributes_policy">Copilot OpenTelemetry エクスポートのエンタープライズ管理 OTel リソース属性を制御します。</string>
			<string id="CopilotOtelServiceName">CopilotOtelServiceName</string>
			<string id="CopilotOtelServiceName_chat_agentHost_otel_serviceName_policy">Copilot OpenTelemetry エクスポートのエンタープライズ マネージド OTel `service.name` リソース属性を制御します。</string>
			<string id="CopilotReviewAgent">CopilotReviewAgent</string>
			<string id="CopilotReviewAgent_github_copilot_chat_reviewAgent_enabled">Enables the code review agent.</string>
			<string id="CopilotReviewSelection">CopilotReviewSelection</string>
			<string id="CopilotReviewSelection_github_copilot_chat_reviewSelection_enabled">Enables code review on current selection.</string>
			<string id="CopilotSessionSync">CopilotSessionSync</string>
			<string id="CopilotSessionSync_chat_sessionSync_enabled_policy">デバイス間での Copilot セッション履歴の GitHub.com へのセッション同期を有効にします。組織のポリシーで無効化されている場合、セッション データはローカルにのみ保存されます。</string>
			<string id="DictationEnabled">DictationEnabled</string>
			<string id="DictationEnabled_dictation_enabled_policy">Controls whether dictation is available across the product (chat input, editor, and terminal).</string>
			<string id="DictationLLMCleanup">DictationLLMCleanup</string>
			<string id="DictationLLMCleanup_dictation_experimental_llmCleanup_policy">Controls whether final dictation transcripts are sent to a language model for cleanup.</string>
			<string id="DictationModel">DictationModel</string>
			<string id="DictationModel_dictation_model_policy">Controls the transcription model used for dictation.</string>
			<string id="DictationModel_dictation_model_nemotronMultilingual_policy">Use the on-device transcription model. Audio does not leave the device.</string>
			<string id="DictationModel_dictation_model_mai_policy">Use the cloud transcription service. Audio is streamed to the service.</string>
			<string id="McpEnterpriseManagedAuthIdp">McpEnterpriseManagedAuthIdp</string>
			<string id="McpEnterpriseManagedAuthIdp_mcp_enterpriseManagedAuth_idp_policy">エンタープライズ管理モデル コンテキスト プロトコル (MCP) サーバー認証に使用される OAuth/OIDC IdP 構成。</string>
			<string id="McpGalleryServiceUrl">McpGalleryServiceUrl</string>
			<string id="McpGalleryServiceUrl_mcp_gallery_serviceUrl">接続する MCP ギャラリー サービス URL を構成する</string>
			<string id="AllowedExtensions">AllowedExtensions</string>
			<string id="AllowedExtensions_extensions_allowed_policy">使用が許可される拡張機能のリストを指定します。これにより、承認されていない拡張機能の使用が制限され、安全で一貫性のある開発環境が維持されます。詳細情報: https://aka.ms/vscode/enterprise/extensions/allowed</string>
			<string id="ExtensionGalleryAuthProvider">ExtensionGalleryAuthProvider</string>
			<string id="ExtensionGalleryAuthProvider_extensions_gallery_authProvider">Configure the authentication provider for the Extensions Marketplace</string>
			<string id="ExtensionGalleryAuthProvider_extensions_gallery_authProvider_github">Authenticate to the Extensions Marketplace using GitHub.</string>
			<string id="ExtensionGalleryAuthProvider_extensions_gallery_authProvider_microsoft">Authenticate to the Extensions Marketplace using a Microsoft (Entra ID) account.</string>
			<string id="ExtensionGalleryServiceUrl">ExtensionGalleryServiceUrl</string>
			<string id="ExtensionGalleryServiceUrl_extensions_gallery_serviceUrl">マーケットプレース サービスの URL を構成してから次に接続します:</string>
			<string id="ExtensionsAutoUpdate">ExtensionsAutoUpdate</string>
			<string id="ExtensionsAutoUpdate_extensions_autoUpdate">拡張機能の自動更新の動作を制御します。更新プログラムは、Microsoft オンライン サービスからフェッチされます。</string>
			<string id="ExtensionsAutoUpdate_extensions_autoUpdate_on">有効にした拡張機能に対してのみ、更新プログラムを自動的にダウンロードしてインストールします。</string>
			<string id="ExtensionsAutoUpdate_extensions_autoUpdate_off">拡張機能は自動的には更新されません。</string>
			<string id="ExtensionsAutoUpdateDelay">ExtensionsAutoUpdateDelay</string>
			<string id="ExtensionsAutoUpdateDelay_extensions_autoUpdateDelay">拡張機能の更新が公開されてから、自動的にインストールされるまでの遅延時間を時間単位で制御します。`#extensions.autoUpdate#` が `on` に設定されている場合にのみ適用されます。この遅延により、リリース直後に問題のある可能性がある更新プログラムがインストールされるのを回避できます。</string>
			<string id="ChatAgentSandboxAllowAutoApprove">ChatAgentSandboxAllowAutoApprove</string>
			<string id="ChatAgentSandboxAllowAutoApprove_agentSandbox_allowAutoApprove">サンドボックス内で実行されるエージェント モードのターミナル コマンドが自動承認されるかどうかを制御します。無効にすると、ターミナル ツールでの実行には既存の承認フローが使用されます。これは、{0} が有効な場合にのみ適用されます。</string>
			<string id="ChatAgentSandboxAllowNetwork">ChatAgentSandboxAllowNetwork</string>
			<string id="ChatAgentSandboxAllowNetwork_agentSandbox_allowNetwork">{0} を有効にすると、サンドボックス内ですべてのネットワーク ドメインを許可するかどうかを制御します。有効にすると、サンドボックスはファイル システムの制限を保持したまま、すべてのネットワーク制限を緩和します。</string>
			<string id="ChatAgentSandboxAllowUnsandboxedCommands">ChatAgentSandboxAllowUnsandboxedCommands</string>
			<string id="ChatAgentSandboxAllowUnsandboxedCommands_agentSandbox_allowUnsandboxedCommands">セキュリティで保護されたコマンドが失敗した場合、またはサンドボックスの制限によってコマンドがブロックされる場合に、ユーザーの確認後にエージェント モードのターミナル コマンドをサンドボックス外で実行できるかどうかを制御します。これは、{0} が有効な場合にのみ適用されます。</string>
			<string id="ChatAgentSandboxEnabled">ChatAgentSandboxEnabled</string>
			<string id="ChatAgentSandboxEnabled_agentSandbox_enabledSetting">エージェント モードでサンドボックスを使用して、ツールで実行できる操作を制限するかどうかを制御します。有効にすると、ターミナルなどのツールがサンドボックス環境で実行され、システムへのアクセスが制限されます。{0} を使用して、すべてのネットワーク ドメインを許可します。</string>
			<string id="ChatAgentSandboxEnabled_agentSandbox_enabledSetting_offDescription">エージェント モード ツールのサンドボックス化を無効にします。</string>
			<string id="ChatAgentSandboxEnabled_agentSandbox_enabledSetting_onDescription">エージェント モード ツールのサンドボックス化を有効にします。</string>
			<string id="ChatToolsTerminalEnableAutoApprove">ChatToolsTerminalEnableAutoApprove</string>
			<string id="ChatToolsTerminalEnableAutoApprove_autoApproveMode_description">ターミナル ツールでの実行時に自動承認を許可するかどうかを制御します。</string>
			<string id="EnableFeedback">EnableFeedback</string>
			<string id="EnableFeedback_telemetry_feedback_enabled">問題報告、アンケート、その他のフィードバック オプションなどのフィードバック メカニズムを有効にします。</string>
			<string id="TelemetryLevel">TelemetryLevel</string>
			<string id="TelemetryLevel_telemetry_telemetryLevel_policyDescription">テレメトリのレベルを制御します。</string>
			<string id="TelemetryLevel_telemetry_telemetryLevel_default">使用状況データ、エラー、クラッシュ レポートを送信します。</string>
			<string id="TelemetryLevel_telemetry_telemetryLevel_error">一般的なエラー テレメトリとクラッシュ レポートを送信します。</string>
			<string id="TelemetryLevel_telemetry_telemetryLevel_crash">OS レベルのクラッシュ レポートを送信します。</string>
			<string id="TelemetryLevel_telemetry_telemetryLevel_off">すべての製品テレメトリを無効にします。</string>
			<string id="UpdateMode">UpdateMode</string>
			<string id="UpdateMode_updateMode">自動更新を受け取るかどうかを構成します。更新プログラムは Microsoft のオンライン サービスから取得されます。</string>
			<string id="UpdateMode_none">なし</string>
			<string id="UpdateMode_manual">バックグラウンドでの自動更新の確認を無効にします。更新を手動で確認すると、更新を利用できます。</string>
			<string id="UpdateMode_start">開始</string>
