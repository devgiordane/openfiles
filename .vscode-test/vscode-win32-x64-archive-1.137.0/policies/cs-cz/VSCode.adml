			<string id="Category_interactiveSessionConfigurationTitle">Interaktivní relace</string>
			<string id="Category_extensionsConfigurationTitle">Rozšíření</string>
			<string id="Category_terminalIntegratedConfigurationTitle">Integrovaný terminál</string>
			<string id="Category_telemetryConfigurationTitle">Telemetry</string>
			<string id="Category_updateConfigurationTitle">Aktualizace</string>
			<string id="AgentsVoice">AgentsVoice</string>
			<string id="AgentsVoice_agents_voice_enabled">Povolit panel hlasového režimu v zobrazení chatu pro konverzace při psaní kódu řízené hlasem.</string>
			<string id="BrowserChatTools">BrowserChatTools</string>
			<string id="BrowserChatTools_browser_enableChatTools">Pokud je tato možnost povolená, můžou chatovací agenti používat nástroje prohlížeče k otevírání stránek a interakci se stránkami v integrovaném prohlížeči.</string>
			<string id="ChatAgentAllowedNetworkDomains">ChatAgentAllowedNetworkDomains</string>
			<string id="ChatAgentAllowedNetworkDomains_chat_agent_allowedNetworkDomains">Povolené domény pro síťový přístup nástrojů agentů (nástroj pro načtení, integrovaný prohlížeč). Platí, pokud je povoleno: {0} nebo {1}. Pokud je povoleno: {2}, jsou povoleny všechny domény. Podporuje zástupné znaky jako {3}. Když jsou seznamy povolených i zakázaných prázdné, všechny domény jsou blokované. Odmítnuté domény (viz {4}) mají přednost.</string>
			<string id="ChatAgentDeniedNetworkDomains">ChatAgentDeniedNetworkDomains</string>
			<string id="ChatAgentDeniedNetworkDomains_chat_agent_deniedNetworkDomains">Odmítnuté domény pro síťový přístup nástrojů agentů (nástroj fetch, integrovaný prohlížeč). Platí, pokud je povoleno: {0} nebo {1}. To neplatí, pokud je povoleno: {2}. Má přednost před {3}. Podporuje zástupné znaky jako {4}.</string>
			<string id="ChatAgentExtensionTools">ChatAgentExtensionTools</string>
			<string id="ChatAgentExtensionTools_chat_extensionToolsEnabled">Umožňuje používat nástroje z rozšíření třetích stran.</string>
			<string id="ChatAgentHostCustomTerminalTool">ChatAgentHostCustomTerminalTool</string>
			<string id="ChatAgentHostCustomTerminalTool_chat_agentHost_customTerminalTool_enabled_policy">Enable the Agent Host custom terminal tool override for Copilot SDK sessions.</string>
			<string id="ChatAgentMode">ChatAgentMode</string>
			<string id="ChatAgentMode_chat_agent_enabled_description">Pokud je tato volba povolená, může být režim agenta aktivován z chatu a lze využívat nástroje s vedlejšími účinky v agentních kontextech.</string>
			<string id="ChatAgentNetworkFilter">ChatAgentNetworkFilter</string>
			<string id="ChatAgentNetworkFilter_chat_agent_networkFilter">Když je tato možnost povolená, síťový přístup nástrojů agentů (nástroj pro načtení změn, integrovaný prohlížeč) je omezen podle {0} a {1}. Když je povolený {2}, filtrování domén se použije i pro tyto nástroje.</string>
			<string id="ChatAllowedMcpServers">ChatAllowedMcpServers</string>
			<string id="ChatAllowedMcpServers_chat_mcp_allowedServers_policy">Allowlist of Model Context Protocol servers. When set, only servers matching an entry may be installed or run; omit entirely to allow all servers (subject to the deny list).</string>
			<string id="ChatAllowManagedHooksOnly">ChatAllowManagedHooksOnly</string>
			<string id="ChatAllowManagedHooksOnly_chat_hooks_allowManagedOnly_policy">Allows hooks only from enterprise-managed sources and plugins force-enabled by policy.</string>
			<string id="ChatAllowManagedMcpServersOnly">ChatAllowManagedMcpServersOnly</string>
			<string id="ChatAllowManagedMcpServersOnly_chat_mcp_allowManagedServersOnly_policy">Use only the enterprise-managed MCP allowlist when deciding which servers may run.</string>
			<string id="ChatApprovedAccountOrganizations">ChatApprovedAccountOrganizations</string>
			<string id="ChatApprovedAccountOrganizations_chat_approvedAccountOrganizations_policy_description">Nastavením této zásady na neprázdný seznam se aktivuje brána Approved Account: všechny funkce AI se deaktivují, dokud se uživatel nepřihlásí k účtu GitHub, jehož organizace mají průnik s tímto seznamem, a dokud se nevyřeší data zásad na straně účtu. Při porovnávání se nerozlišují malá a velká písmena. Použijte '*' jako zástupný znak pro přijetí libovolného přihlášeného účtu GitHub nebo GHE (použijte u nasazení GHE, kde se nezobrazuje seznam organizací).</string>
			<string id="ChatDefaultModel">ChatDefaultModel</string>
			<string id="ChatDefaultModel_chat_defaultModel_policy">Nastaví výchozí model chatu pro nové konverzace. Přijímá hodnotu „auto“, název rodiny modelů (například „opus“ nebo „gemini“) nebo úplné ID modelu. Uživatelé můžou model v konverzaci i nadále přepínat.</string>
			<string id="ChatDeniedMcpServers">ChatDeniedMcpServers</string>
			<string id="ChatDeniedMcpServers_chat_mcp_deniedServers_policy">Denylist of Model Context Protocol servers. Servers matching any entry are blocked from being installed or run, even if they also match the allow list; deny rules always take precedence.</string>
			<string id="ChatEditorPreferCopilotHarness">ChatEditorPreferCopilotHarness</string>
			<string id="ChatEditorPreferCopilotHarness_chat_editor_preferCopilotHarness_policy">Configure whether VS Code uses the Agent Host Copilot SDK instead of the local harness for new editor chat sessions.</string>
			<string id="ChatEnabledPlugins">ChatEnabledPlugins</string>
			<string id="ChatEnabledPlugins_chat_plugins_enabledPlugins_policy">Povolení modulu plug-in. Klíče jsou ID pluginů ve formátu `{plugin}@{marketplace}`. Hodnoty plugin povolují nebo zakazují.</string>
			<string id="ChatExtraMarketplaces">ChatExtraMarketplaces</string>
			<string id="ChatExtraMarketplaces_chat_plugins_extraMarketplaces_policy">Additional plugin marketplaces to query. Keys are marketplace names; values are GitHub shorthand (`owner/repo[#ref]`) or Git URIs (`{url}[#ref]`), optionally with an enterprise-managed auto-update override.</string>
			<string id="ChatHooks">ChatHooks</string>
			<string id="ChatHooks_chat_useHooks_description">Controls whether chat hooks are executed at strategic points during an agent's workflow. Hooks are loaded from the files configured in `#chat.hookFilesLocations#`. This setting is only used by the Local agent harness.</string>
			<string id="ChatMCP">ChatMCP</string>
			<string id="ChatMCP_chat_mcp_access">Řídí přístup k nainstalovaným serverům protokolu Model Context Protocol.</string>
			<string id="ChatMCP_chat_mcp_access_none">Nemáte přístup k serverům MCP.</string>
			<string id="ChatMCP_chat_mcp_access_registry">Allows access to MCP servers listed in the registry that VS Code is connected to.</string>
			<string id="ChatMCP_chat_mcp_access_any">Povolení přístupu k libovolnému nainstalovanému serveru MCP.</string>
			<string id="ChatPluginsEnabled">ChatPluginsEnabled</string>
			<string id="ChatPluginsEnabled_chat_plugins_enabled">Povolte integraci modulu plug-in agenta v chatu.</string>
			<string id="ChatStrictMarketplaces">ChatStrictMarketplaces</string>
			<string id="ChatStrictMarketplaces_chat_plugins_strictMarketplaces_policy">Seznam povolených zdrojů marketplace pluginů. Když je nastaven, důvěryhodné jsou jen marketplace odpovídající některé položce. Prázdné pole blokuje všechny marketplace.</string>
			<string id="ChatStrictPluginOnlyCustomization">ChatStrictPluginOnlyCustomization</string>
			<string id="ChatStrictPluginOnlyCustomization_chat_customizations_strictPluginOnlyCustomization_policy">Blocks standalone user and workspace skills, agents, hooks, instructions, and MCP servers while keeping eligible plugin customizations available.</string>
			<string id="ChatToolsAutoApprove">ChatToolsAutoApprove</string>
			<string id="ChatToolsAutoApprove_autoApprove3_description">Globální automatické schvalování, známé také jako „režim YOLO“, zcela vypíná ruční schvalování pro všechny nástroje ve všech pracovních prostorech a umožňuje agentovi jednat plně autonomně. Toto je mimořádně nebezpečné a nikdy se to nedoporučuje, i v kontejnerizovaných prostředích, jako jsou Codespaces a Dev Containers, jsou do kontejneru přeposílány uživatelské klíče, které mohou být kompromitovány.

Tato funkce vypíná klíčové bezpečnostní ochrany a výrazně usnadňuje útočníkovi kompromitaci zařízení.

Poznámka: Toto nastavení řídí pouze schvalování nástrojů a nebrání agentovi v kladení otázek. Pokud chcete automaticky odpovídat na otázky agenta, použijte nastavení `#chat.autoReply#`.</string>
			<string id="ChatToolsEligibleForAutoApproval">ChatToolsEligibleForAutoApproval</string>
			<string id="ChatToolsEligibleForAutoApproval_chat_tools_eligibleForAutoApproval">Určuje, které nástroje mají nárok na automatické schválení. Nástroje nastavené na false vždy zobrazí potvrzení a nikdy nenabízejí možnost automatického schválení. Výchozí chování (nebo nastavení nástroje na true) může vést k tomu, že nástroj nabízí možnosti automatického schválení.</string>
			<string id="Claude3PIntegration">Claude3PIntegration</string>
			<string id="Claude3PIntegration_chat_agentHost_claudeAgent_enabled_policy">Povolte relace agentů Claude ve VS Code. Spusťte a obnovte relace agentického kódování využívající sadu Claude Agent SDK společnosti Anthropic přímo v editoru. Používá vaše stávající předplatné Copilota.</string>
			<string id="Codex3PIntegration">Codex3PIntegration</string>
			<string id="Codex3PIntegration_chat_agentHost_codexAgent_enabled_policy">Enable Codex Agent sessions in VS Code. Start and resume agentic coding sessions powered by OpenAI Codex. Usage can be routed through GitHub Copilot or authenticated directly with an OpenAI account.</string>
			<string id="CopilotNextEditSuggestions">CopilotNextEditSuggestions</string>
			<string id="CopilotNextEditSuggestions_github_copilot_nextEditSuggestions_enabled">Whether to enable next edit suggestions (NES). NES can propose a next edit based on your recent changes.</string>
			<string id="CopilotOtelCaptureContent">CopilotOtelCaptureContent</string>
			<string id="CopilotOtelCaptureContent_chat_agentHost_otel_captureContent_policy">Určuje, jestli export Copilot OpenTelemetry zachycuje výzvu, odpověď a obsah nástroje.</string>
			<string id="CopilotOtelEnabled">CopilotOtelEnabled</string>
			<string id="CopilotOtelEnabled_chat_agentHost_otel_enabled_policy">Určuje, jestli je povolený export Copilot OpenTelemetry. Při správě nemohou uživatelé přepsat hodnotu organizace.</string>
			<string id="CopilotOtelEndpoint">CopilotOtelEndpoint</string>
			<string id="CopilotOtelEndpoint_chat_agentHost_otel_otlpEndpoint_policy">Řídí koncový bod kolektoru OTLP spravovaný podnikem pro export Copilot OpenTelemetry.</string>
			<string id="CopilotOtelHeaders">CopilotOtelHeaders</string>
			<string id="CopilotOtelHeaders_chat_agentHost_otel_headers_policy">Řídí hlavičky exportéru OTLP spravované podnikem pro export Copilot OpenTelemetry.</string>
			<string id="CopilotOtelOtlpProtocol">CopilotOtelOtlpProtocol</string>
			<string id="CopilotOtelOtlpProtocol_chat_agentHost_otel_otlpProtocol_policy">Řídí přenosový protokol OTLP spravovaný podnikem (protobuf vs. JSON) pro export Copilot OpenTelemetry.</string>
			<string id="CopilotOtelOutfile">CopilotOtelOutfile</string>
			<string id="CopilotOtelOutfile_chat_agentHost_otel_outfile_policy">Zabraňuje místnímu exportu souborů, když je nakonfigurovaný export Copilot OpenTelemetry spravovaný podnikem.</string>
			<string id="CopilotOtelProtocol">CopilotOtelProtocol</string>
			<string id="CopilotOtelProtocol_chat_agentHost_otel_protocol_policy">Řídí protokol OTLP spravovaný podnikem pro export Copilot OpenTelemetry.</string>
			<string id="CopilotOtelProtocol_chat_agentHost_otel_protocol_policy_otlpHttp">Použijte OTLP přes HTTP.</string>
			<string id="CopilotOtelProtocol_chat_agentHost_otel_protocol_policy_otlpGrpc">Použít OTLP přes gRPC.</string>
			<string id="CopilotOtelProtocol_chat_agentHost_otel_protocol_policy_console">Exportér konzole není vybrán nastavením spravovaným podnikem.</string>
			<string id="CopilotOtelProtocol_chat_agentHost_otel_protocol_policy_file">Exportér souborů není vybrán nastavením spravovaným podnikem.</string>
			<string id="CopilotOtelResourceAttributes">CopilotOtelResourceAttributes</string>
			<string id="CopilotOtelResourceAttributes_chat_agentHost_otel_resourceAttributes_policy">Řídí atributy prostředku OTel spravované podnikem pro export Copilot OpenTelemetry.</string>
			<string id="CopilotOtelServiceName">CopilotOtelServiceName</string>
			<string id="CopilotOtelServiceName_chat_agentHost_otel_serviceName_policy">Atribut prostředku OTel `service.name` spravovaný podnikem pro export Copilot OpenTelemetry.</string>
			<string id="CopilotReviewAgent">CopilotReviewAgent</string>
			<string id="CopilotReviewAgent_github_copilot_chat_reviewAgent_enabled">Enables the code review agent.</string>
			<string id="CopilotReviewSelection">CopilotReviewSelection</string>
			<string id="CopilotReviewSelection_github_copilot_chat_reviewSelection_enabled">Enables code review on current selection.</string>
			<string id="CopilotSessionSync">CopilotSessionSync</string>
			<string id="CopilotSessionSync_chat_sessionSync_enabled_policy">Povolte synchronizaci relací pro GitHub.com pro historii relací Copilota mezi zařízeními. Pokud jsou zakázána zásadami organizace, data relace se uchovávají pouze místně.</string>
			<string id="DictationEnabled">DictationEnabled</string>
			<string id="DictationEnabled_dictation_enabled_policy">Controls whether dictation is available across the product (chat input, editor, and terminal).</string>
			<string id="DictationLLMCleanup">DictationLLMCleanup</string>
			<string id="DictationLLMCleanup_dictation_experimental_llmCleanup_policy">Controls whether final dictation transcripts are sent to a language model for cleanup.</string>
			<string id="DictationModel">DictationModel</string>
			<string id="DictationModel_dictation_model_policy">Controls the transcription model used for dictation.</string>
			<string id="DictationModel_dictation_model_nemotronMultilingual_policy">Use the on-device transcription model. Audio does not leave the device.</string>
			<string id="DictationModel_dictation_model_mai_policy">Use the cloud transcription service. Audio is streamed to the service.</string>
			<string id="McpEnterpriseManagedAuthIdp">McpEnterpriseManagedAuthIdp</string>
			<string id="McpEnterpriseManagedAuthIdp_mcp_enterpriseManagedAuth_idp_policy">Konfigurace zprostředkovatele identity OAuth/OIDC použitá k ověřování serveru MCP (Model Context Protocol) spravovaného podnikem.</string>
			<string id="McpGalleryServiceUrl">McpGalleryServiceUrl</string>
			<string id="McpGalleryServiceUrl_mcp_gallery_serviceUrl">Nakonfigurovat adresu URL služby Galerie MCP pro připojení k</string>
			<string id="AllowedExtensions">AllowedExtensions</string>
			<string id="AllowedExtensions_extensions_allowed_policy">Zadejte seznam rozšíření, která mohou být použita. Pomáhá udržovat zabezpečené a konzistentní vývojové prostředí tím, že je omezeno používání neautorizovaných rozšíření. Další informace: https://aka.ms/vscode/enterprise/extensions/allowed</string>
			<string id="ExtensionGalleryAuthProvider">ExtensionGalleryAuthProvider</string>
			<string id="ExtensionGalleryAuthProvider_extensions_gallery_authProvider">Configure the authentication provider for the Extensions Marketplace</string>
			<string id="ExtensionGalleryAuthProvider_extensions_gallery_authProvider_github">Authenticate to the Extensions Marketplace using GitHub.</string>
			<string id="ExtensionGalleryAuthProvider_extensions_gallery_authProvider_microsoft">Authenticate to the Extensions Marketplace using a Microsoft (Entra ID) account.</string>
			<string id="ExtensionGalleryServiceUrl">ExtensionGalleryServiceUrl</string>
			<string id="ExtensionGalleryServiceUrl_extensions_gallery_serviceUrl">Nakonfigurovat adresu URL služby Marketplace pro připojení k</string>
			<string id="ExtensionsAutoUpdate">ExtensionsAutoUpdate</string>
			<string id="ExtensionsAutoUpdate_extensions_autoUpdate">Určuje chování automatických aktualizací rozšíření. Aktualizace se načítají z online služby Microsoftu.</string>
			<string id="ExtensionsAutoUpdate_extensions_autoUpdate_on">Umožňuje automaticky stahovat a instalovat aktualizace pouze pro vybraná rozšíření.</string>
			<string id="ExtensionsAutoUpdate_extensions_autoUpdate_off">Rozšíření se neaktualizují automaticky.</string>
			<string id="ExtensionsAutoUpdateDelay">ExtensionsAutoUpdateDelay</string>
			<string id="ExtensionsAutoUpdateDelay_extensions_autoUpdateDelay">Řídí zpoždění v hodinách po publikování aktualizace rozšíření, než se automaticky nainstaluje. Platí jen v případě, že `#extensions.autoUpdate#` je nastaveno na `on`. Toto zpoždění pomáhá zabránit okamžité instalaci potenciálně problematických aktualizací po vydání.</string>
			<string id="ChatAgentSandboxAllowAutoApprove">ChatAgentSandboxAllowAutoApprove</string>
			<string id="ChatAgentSandboxAllowAutoApprove_agentSandbox_allowAutoApprove">Určuje, jestli se mají automaticky schvalovat terminálové příkazy v režimu agenta, které běží v sandboxu. Když je tato možnost vypnutá, nástroj pro spuštění v terminálu používá stávající tok schvalování. Platí jen v případě, že je povolená možnost {0}.</string>
			<string id="ChatAgentSandboxAllowNetwork">ChatAgentSandboxAllowNetwork</string>
			<string id="ChatAgentSandboxAllowNetwork_agentSandbox_allowNetwork">Když je možnost {0} zapnutá, určuje, zda povolit v sandboxu všechny síťové domény. Když je tato možnost zapnutá, sandbox zachová omezení systému souborů a zároveň uvolní všechna síťová omezení.</string>
			<string id="ChatAgentSandboxAllowUnsandboxedCommands">ChatAgentSandboxAllowUnsandboxedCommands</string>
			<string id="ChatAgentSandboxAllowUnsandboxedCommands_agentSandbox_allowUnsandboxedCommands">Určuje, jestli se příkazy v režimu agenta můžou po potvrzení uživatelem spouštět mimo sandbox, když selže příkaz v sandboxu nebo když by omezení sandboxu příkaz zablokovala. Platí jen v případě, že je povolená možnost {0}.</string>
			<string id="ChatAgentSandboxEnabled">ChatAgentSandboxEnabled</string>
			<string id="ChatAgentSandboxEnabled_agentSandbox_enabledSetting">Určuje, zda režim agenta používá sandboxing k omezení toho, co mohou nástroje provádět. Pokud je povoleno, nástroje, jako je terminál, běží v prostředí sandboxu, které omezuje přístup k systému. Použijte {0} k povolení všech síťových domén.</string>
			<string id="ChatAgentSandboxEnabled_agentSandbox_enabledSetting_offDescription">Zakázat sandboxing pro nástroje režimu agenta</string>
			<string id="ChatAgentSandboxEnabled_agentSandbox_enabledSetting_onDescription">Povolte sandboxing pro nástroje režimu agenta.</string>
			<string id="ChatToolsTerminalEnableAutoApprove">ChatToolsTerminalEnableAutoApprove</string>
			<string id="ChatToolsTerminalEnableAutoApprove_autoApproveMode_description">Určuje, jestli se má povolit automatické schvalování při spuštění v nástroji terminálu.</string>
			<string id="EnableFeedback">EnableFeedback</string>
			<string id="EnableFeedback_telemetry_feedback_enabled">Povolte mechanismy zpětné vazby, například hlášení problémů, průzkumy a další možnosti zpětné vazby.</string>
			<string id="TelemetryLevel">TelemetryLevel</string>
			<string id="TelemetryLevel_telemetry_telemetryLevel_policyDescription">Řídí úroveň telemetrie.</string>
			<string id="TelemetryLevel_telemetry_telemetryLevel_default">Odesílá data o využití, chyby a hlášení o selhání.</string>
			<string id="TelemetryLevel_telemetry_telemetryLevel_error">Odesílá obecné hlášení o selhání a telemetrii chyb.</string>
			<string id="TelemetryLevel_telemetry_telemetryLevel_crash">Odesílá hlášení o selhání na úrovni operačního systému.</string>
			<string id="TelemetryLevel_telemetry_telemetryLevel_off">Zakáže veškerou telemetrii produktu.</string>
			<string id="UpdateMode">UpdateMode</string>
			<string id="UpdateMode_updateMode">Umožňuje nakonfigurovat, jestli budete dostávat automatické aktualizace. Aktualizace se načítají z online služby Microsoftu.</string>
			<string id="UpdateMode_none">Žádné</string>
			<string id="UpdateMode_manual">Zakázat automatické vyhledávání aktualizací na pozadí (aktualizace lze nechat vyhledat ručně)</string>
			<string id="UpdateMode_start">Spustit</string>
			<string id="UpdateMode_default">Systém</string>
		</stringTable>
		<presentationTable>
			<presentation id="AgentsVoice"><checkBox refId="AgentsVoice">AgentsVoice</checkBox></presentation>
			<presentation id="BrowserChatTools"><checkBox refId="BrowserChatTools">BrowserChatTools</checkBox></presentation>
			<presentation id="ChatAgentAllowedNetworkDomains"><multiTextBox refId="ChatAgentAllowedNetworkDomains" /></presentation>
