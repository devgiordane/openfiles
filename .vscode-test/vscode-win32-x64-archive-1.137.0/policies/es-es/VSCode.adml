			<string id="Category_interactiveSessionConfigurationTitle">Sesión interactiva</string>
			<string id="Category_extensionsConfigurationTitle">Extensiones</string>
			<string id="Category_terminalIntegratedConfigurationTitle">Terminal integrado</string>
			<string id="Category_telemetryConfigurationTitle">Telemetría</string>
			<string id="Category_updateConfigurationTitle">Actualizar</string>
			<string id="AgentsVoice">AgentsVoice</string>
			<string id="AgentsVoice_agents_voice_enabled">Habilite el panel Modo de voz en la vista de chat para conversaciones de programación guiadas por voz.</string>
			<string id="BrowserChatTools">BrowserChatTools</string>
			<string id="BrowserChatTools_browser_enableChatTools">Cuando se habilita, los agentes de chat pueden usar herramientas del explorador para abrir e interactuar con páginas en el explorador integrado.</string>
			<string id="ChatAgentAllowedNetworkDomains">ChatAgentAllowedNetworkDomains</string>
			<string id="ChatAgentAllowedNetworkDomains_chat_agent_allowedNetworkDomains">Dominios permitidos para el acceso a la red mediante herramientas de agente (herramienta de captura, explorador integrado). Se aplica cuando {0} o {1} está habilitado. Cuando {2} está habilitado, se permiten todos los dominios. Admite caracteres comodín como {3}. Cuando las listas de permitidos y denegados están vacías, se bloquean todos los dominios. Los dominios denegados (consulte {4}) tienen prioridad.</string>
			<string id="ChatAgentDeniedNetworkDomains">ChatAgentDeniedNetworkDomains</string>
			<string id="ChatAgentDeniedNetworkDomains_chat_agent_deniedNetworkDomains">Dominios denegados para el acceso a la red por parte de las herramientas del agente (herramienta de captura, explorador integrado). Se aplica cuando {0} o {1} está habilitado. Esto no se aplica cuando {2} está habilitado. Tiene prioridad sobre {3}. Admite caracteres comodín como {4}.</string>
			<string id="ChatAgentExtensionTools">ChatAgentExtensionTools</string>
			<string id="ChatAgentExtensionTools_chat_extensionToolsEnabled">Habilite el uso de herramientas aportadas por extensiones de terceros.</string>
			<string id="ChatAgentHostCustomTerminalTool">ChatAgentHostCustomTerminalTool</string>
			<string id="ChatAgentHostCustomTerminalTool_chat_agentHost_customTerminalTool_enabled_policy">Enable the Agent Host custom terminal tool override for Copilot SDK sessions.</string>
			<string id="ChatAgentMode">ChatAgentMode</string>
			<string id="ChatAgentMode_chat_agent_enabled_description">Cuando está habilitado, se puede activar el modo agente desde el chat y se pueden usar herramientas en contextos con efectos secundarios.</string>
			<string id="ChatAgentNetworkFilter">ChatAgentNetworkFilter</string>
			<string id="ChatAgentNetworkFilter_chat_agent_networkFilter">Cuando se habilita, el acceso a la red mediante las herramientas del agente (herramienta de captura, explorador integrado) está restringido según {0} y {1}. El filtrado de dominios también se aplica a esas herramientas cuando {2} está habilitado.</string>
			<string id="ChatAllowedMcpServers">ChatAllowedMcpServers</string>
			<string id="ChatAllowedMcpServers_chat_mcp_allowedServers_policy">Allowlist of Model Context Protocol servers. When set, only servers matching an entry may be installed or run; omit entirely to allow all servers (subject to the deny list).</string>
			<string id="ChatAllowManagedHooksOnly">ChatAllowManagedHooksOnly</string>
			<string id="ChatAllowManagedHooksOnly_chat_hooks_allowManagedOnly_policy">Allows hooks only from enterprise-managed sources and plugins force-enabled by policy.</string>
			<string id="ChatAllowManagedMcpServersOnly">ChatAllowManagedMcpServersOnly</string>
			<string id="ChatAllowManagedMcpServersOnly_chat_mcp_allowManagedServersOnly_policy">Use only the enterprise-managed MCP allowlist when deciding which servers may run.</string>
			<string id="ChatApprovedAccountOrganizations">ChatApprovedAccountOrganizations</string>
			<string id="ChatApprovedAccountOrganizations_chat_approvedAccountOrganizations_policy_description">Al establecer esta directiva en una lista no vacía, se activa la puerta cuenta aprobada: todas las características de IA se deshabilitan hasta que el usuario inicia sesión en una cuenta de GitHub cuyas organizaciones forman una intersección con esta lista y se han resuelto los datos de la directiva del lado de la cuenta. La comparación no distingue mayúsculas de minúsculas. Use "*" como carácter comodín para aceptar cualquier cuenta de GitHub o GHE que haya iniciado sesión (use esto para las implementaciones de GHE en las que no aparece la lista de la organización).</string>
			<string id="ChatDefaultModel">ChatDefaultModel</string>
			<string id="ChatDefaultModel_chat_defaultModel_policy">Establece el modelo de chat predeterminado para las conversaciones nuevas. Acepta "auto", un nombre de familia de modelo (como "opus" o "gemini") o un identificador completo de modelo. Los usuarios aún pueden cambiar el modelo dentro de una conversación.</string>
			<string id="ChatDeniedMcpServers">ChatDeniedMcpServers</string>
			<string id="ChatDeniedMcpServers_chat_mcp_deniedServers_policy">Denylist of Model Context Protocol servers. Servers matching any entry are blocked from being installed or run, even if they also match the allow list; deny rules always take precedence.</string>
			<string id="ChatEditorPreferCopilotHarness">ChatEditorPreferCopilotHarness</string>
			<string id="ChatEditorPreferCopilotHarness_chat_editor_preferCopilotHarness_policy">Configure whether VS Code uses the Agent Host Copilot SDK instead of the local harness for new editor chat sessions.</string>
			<string id="ChatEnabledPlugins">ChatEnabledPlugins</string>
			<string id="ChatEnabledPlugins_chat_plugins_enabledPlugins_policy">Habilitación del complemento. Las claves son identificadores de complemento en el formulario `{plugin}@{marketplace}`; los valores de habilitan o deshabilitan el complemento.</string>
			<string id="ChatExtraMarketplaces">ChatExtraMarketplaces</string>
			<string id="ChatExtraMarketplaces_chat_plugins_extraMarketplaces_policy">Additional plugin marketplaces to query. Keys are marketplace names; values are GitHub shorthand (`owner/repo[#ref]`) or Git URIs (`{url}[#ref]`), optionally with an enterprise-managed auto-update override.</string>
			<string id="ChatHooks">ChatHooks</string>
			<string id="ChatHooks_chat_useHooks_description">Controls whether chat hooks are executed at strategic points during an agent's workflow. Hooks are loaded from the files configured in `#chat.hookFilesLocations#`. This setting is only used by the Local agent harness.</string>
			<string id="ChatMCP">ChatMCP</string>
			<string id="ChatMCP_chat_mcp_access">Controla el acceso para los servidores del Protocolo de Contexto del Modelo instalados.</string>
			<string id="ChatMCP_chat_mcp_access_none">No hay acceso a los servidores.</string>
			<string id="ChatMCP_chat_mcp_access_registry">Allows access to MCP servers listed in the registry that VS Code is connected to.</string>
			<string id="ChatMCP_chat_mcp_access_any">Permita el acceso a cualquier servidor MCP instalado.</string>
			<string id="ChatPluginsEnabled">ChatPluginsEnabled</string>
			<string id="ChatPluginsEnabled_chat_plugins_enabled">Habilitar la integración del complemento de agente en el chat.</string>
			<string id="ChatStrictMarketplaces">ChatStrictMarketplaces</string>
			<string id="ChatStrictMarketplaces_chat_plugins_strictMarketplaces_policy">Lista de permitidos de orígenes de Marketplace de complementos. Cuando se establece, solo se confía en los marketplaces que coinciden con una entrada; una matriz vacía bloquea todos los marketplaces.</string>
			<string id="ChatStrictPluginOnlyCustomization">ChatStrictPluginOnlyCustomization</string>
			<string id="ChatStrictPluginOnlyCustomization_chat_customizations_strictPluginOnlyCustomization_policy">Blocks standalone user and workspace skills, agents, hooks, instructions, and MCP servers while keeping eligible plugin customizations available.</string>
			<string id="ChatToolsAutoApprove">ChatToolsAutoApprove</string>
			<string id="ChatToolsAutoApprove_autoApprove3_description">La aprobación automática global también conocida como "modo YOLO" deshabilita completamente la aprobación manual para todas las herramientas de todas las áreas de trabajo, lo que permite que el agente actúe de forma totalmente autónoma. Esto es extremadamente peligroso y *nunca* se recomienda, incluso los entornos en contenedores como Codespaces y Dev Containers tienen claves de usuario reenviadas al contenedor que podrían estar en peligro.

Esta característica deshabilita las protecciones de seguridad críticas y facilita mucho a un atacante poner en peligro la máquina.

Nota: esta configuración solo controla la aprobación de herramientas y no impide que el agente formule preguntas. Para responder automáticamente a las preguntas del agente, use la `#chat.autoReply#` configuración.</string>
			<string id="ChatToolsEligibleForAutoApproval">ChatToolsEligibleForAutoApproval</string>
			<string id="ChatToolsEligibleForAutoApproval_chat_tools_eligibleForAutoApproval">Controla qué herramientas pueden aprobarse automáticamente. Las herramientas configuradas en 'false' siempre pedirán confirmación y nunca ofrecerán la opción de aprobación automática. El comportamiento predeterminado (o configurar una herramienta en 'true') puede hacer que la herramienta ofrezca opciones de aprobación automática.</string>
			<string id="Claude3PIntegration">Claude3PIntegration</string>
			<string id="Claude3PIntegration_chat_agentHost_claudeAgent_enabled_policy">Habilite las sesiones del agente Claude en VS Code. Inicie y reanude sesiones de codificación agentiva impulsadas por el SDK de Claude Agent directamente en el editor. Use su suscripción actual de Copilot.</string>
			<string id="Codex3PIntegration">Codex3PIntegration</string>
			<string id="Codex3PIntegration_chat_agentHost_codexAgent_enabled_policy">Enable Codex Agent sessions in VS Code. Start and resume agentic coding sessions powered by OpenAI Codex. Usage can be routed through GitHub Copilot or authenticated directly with an OpenAI account.</string>
			<string id="CopilotNextEditSuggestions">CopilotNextEditSuggestions</string>
			<string id="CopilotNextEditSuggestions_github_copilot_nextEditSuggestions_enabled">Whether to enable next edit suggestions (NES). NES can propose a next edit based on your recent changes.</string>
			<string id="CopilotOtelCaptureContent">CopilotOtelCaptureContent</string>
			<string id="CopilotOtelCaptureContent_chat_agentHost_otel_captureContent_policy">Controla si la exportación de OpenTelemetry de Copilot captura el contenido de la indicación, la respuesta y la herramienta.</string>
			<string id="CopilotOtelEnabled">CopilotOtelEnabled</string>
			<string id="CopilotOtelEnabled_chat_agentHost_otel_enabled_policy">Controla si la exportación de OpenTelemetry de Copilot está habilitada. Cuando se administra, los usuarios no pueden invalidar el valor empresarial.</string>
			<string id="CopilotOtelEndpoint">CopilotOtelEndpoint</string>
			<string id="CopilotOtelEndpoint_chat_agentHost_otel_otlpEndpoint_policy">Controla el punto de conexión del recopilador OTLP administrado por la empresa para la exportación de OpenTelemetry de Copilot.</string>
			<string id="CopilotOtelHeaders">CopilotOtelHeaders</string>
			<string id="CopilotOtelHeaders_chat_agentHost_otel_headers_policy">Controla los encabezados de exportador de OTLP administrados por la empresa para la exportación de OpenTelemetry de Copilot.</string>
			<string id="CopilotOtelOtlpProtocol">CopilotOtelOtlpProtocol</string>
			<string id="CopilotOtelOtlpProtocol_chat_agentHost_otel_otlpProtocol_policy">Controla el protocolo de red OTLP administrado por la empresa (protobuf frente a JSON) para la exportación de OpenTelemetry de Copilot.</string>
			<string id="CopilotOtelOutfile">CopilotOtelOutfile</string>
			<string id="CopilotOtelOutfile_chat_agentHost_otel_outfile_policy">Impide la exportación de archivos local cuando se configura la exportación de OpenTelemetry de Copilot administrada por la empresa.</string>
			<string id="CopilotOtelProtocol">CopilotOtelProtocol</string>
			<string id="CopilotOtelProtocol_chat_agentHost_otel_protocol_policy">Controla el protocolo OTLP administrado por la empresa para la exportación de OpenTelemetry de Copilot.</string>
			<string id="CopilotOtelProtocol_chat_agentHost_otel_protocol_policy_otlpHttp">Use OTLP sobre HTTP.</string>
			<string id="CopilotOtelProtocol_chat_agentHost_otel_protocol_policy_otlpGrpc">Usar OTLP sobre gRPC.</string>
			<string id="CopilotOtelProtocol_chat_agentHost_otel_protocol_policy_console">La configuración administrada de la empresa no selecciona el exportador de la consola.</string>
			<string id="CopilotOtelProtocol_chat_agentHost_otel_protocol_policy_file">La configuración administrada de la empresa no selecciona el exportador de archivos.</string>
			<string id="CopilotOtelResourceAttributes">CopilotOtelResourceAttributes</string>
			<string id="CopilotOtelResourceAttributes_chat_agentHost_otel_resourceAttributes_policy">Controla los atributos de recursos de OTel administrados por la empresa para la exportación de OpenTelemetry de Copilot.</string>
			<string id="CopilotOtelServiceName">CopilotOtelServiceName</string>
			<string id="CopilotOtelServiceName_chat_agentHost_otel_serviceName_policy">Controla el atributo de recurso `service.name` de OTel administrado por la empresa para la exportación de OpenTelemetry de Copilot.</string>
			<string id="CopilotReviewAgent">CopilotReviewAgent</string>
			<string id="CopilotReviewAgent_github_copilot_chat_reviewAgent_enabled">Enables the code review agent.</string>
			<string id="CopilotReviewSelection">CopilotReviewSelection</string>
			<string id="CopilotReviewSelection_github_copilot_chat_reviewSelection_enabled">Enables code review on current selection.</string>
			<string id="CopilotSessionSync">CopilotSessionSync</string>
			<string id="CopilotSessionSync_chat_sessionSync_enabled_policy">Habilite la sincronización de sesión para GitHub.com para el historial de sesiones de Copilot entre dispositivos. Cuando se deshabilita por la directiva de la organización, los datos de sesión se mantienen solo locales.</string>
			<string id="DictationEnabled">DictationEnabled</string>
			<string id="DictationEnabled_dictation_enabled_policy">Controls whether dictation is available across the product (chat input, editor, and terminal).</string>
			<string id="DictationLLMCleanup">DictationLLMCleanup</string>
			<string id="DictationLLMCleanup_dictation_experimental_llmCleanup_policy">Controls whether final dictation transcripts are sent to a language model for cleanup.</string>
			<string id="DictationModel">DictationModel</string>
			<string id="DictationModel_dictation_model_policy">Controls the transcription model used for dictation.</string>
			<string id="DictationModel_dictation_model_nemotronMultilingual_policy">Use the on-device transcription model. Audio does not leave the device.</string>
			<string id="DictationModel_dictation_model_mai_policy">Use the cloud transcription service. Audio is streamed to the service.</string>
			<string id="McpEnterpriseManagedAuthIdp">McpEnterpriseManagedAuthIdp</string>
			<string id="McpEnterpriseManagedAuthIdp_mcp_enterpriseManagedAuth_idp_policy">La configuración de IdP de OAuth/OIDC usada para la autenticación de servidor de Protocolo de contexto de modelo (MCP) administrada por la empresa.</string>
			<string id="McpGalleryServiceUrl">McpGalleryServiceUrl</string>
			<string id="McpGalleryServiceUrl_mcp_gallery_serviceUrl">Configuración de la dirección URL del servicio de la galería MCP a la que conectarse</string>
			<string id="AllowedExtensions">AllowedExtensions</string>
			<string id="AllowedExtensions_extensions_allowed_policy">Especifique una lista de extensiones que se pueden utilizar. Esto ayuda a mantener un entorno de desarrollo seguro y coherente al restringir el uso de extensiones no autorizadas. Más información: https://aka.ms/vscode/enterprise/extensions/allowed</string>
			<string id="ExtensionGalleryAuthProvider">ExtensionGalleryAuthProvider</string>
			<string id="ExtensionGalleryAuthProvider_extensions_gallery_authProvider">Configure the authentication provider for the Extensions Marketplace</string>
			<string id="ExtensionGalleryAuthProvider_extensions_gallery_authProvider_github">Authenticate to the Extensions Marketplace using GitHub.</string>
			<string id="ExtensionGalleryAuthProvider_extensions_gallery_authProvider_microsoft">Authenticate to the Extensions Marketplace using a Microsoft (Entra ID) account.</string>
			<string id="ExtensionGalleryServiceUrl">ExtensionGalleryServiceUrl</string>
			<string id="ExtensionGalleryServiceUrl_extensions_gallery_serviceUrl">Configurar la dirección URL del servicio de Marketplace a la que conectarse</string>
			<string id="ExtensionsAutoUpdate">ExtensionsAutoUpdate</string>
			<string id="ExtensionsAutoUpdate_extensions_autoUpdate">Controla el comportamiento de actualización automática de las extensiones. Las actualizaciones se obtienen de un servicio en línea de Microsoft.</string>
			<string id="ExtensionsAutoUpdate_extensions_autoUpdate_on">Descarga e instala las actualizaciones de forma automática solo para las extensiones habilitadas.</string>
			<string id="ExtensionsAutoUpdate_extensions_autoUpdate_off">Las extensiones no se actualizan automáticamente.</string>
			<string id="ExtensionsAutoUpdateDelay">ExtensionsAutoUpdateDelay</string>
			<string id="ExtensionsAutoUpdateDelay_extensions_autoUpdateDelay">Controla el retraso en horas después de que se publique una actualización de extensión antes de que se instale automáticamente. Solo se aplica cuando `#extensions.autoUpdate#` se establece en `on`. Este retraso ayuda a evitar la instalación de actualizaciones potencialmente problemáticas inmediatamente después del lanzamiento.</string>
			<string id="ChatAgentSandboxAllowAutoApprove">ChatAgentSandboxAllowAutoApprove</string>
			<string id="ChatAgentSandboxAllowAutoApprove_agentSandbox_allowAutoApprove">Controla si los comandos de terminal del modo agente que se ejecutan dentro del espacio aislado se aprueban automáticamente. Cuando se deshabilita, la ejecución en la herramienta terminal usa el flujo de aprobación existente. Esto solo se aplica cuando {0} está habilitado.</string>
			<string id="ChatAgentSandboxAllowNetwork">ChatAgentSandboxAllowNetwork</string>
			<string id="ChatAgentSandboxAllowNetwork_agentSandbox_allowNetwork">Cuando {0} está habilitado, controla si se permiten todos los dominios de red en el espacio aislado. Cuando se habilita, el espacio aislado conserva las restricciones del sistema de archivos mientras se relajan todas las restricciones de red.</string>
			<string id="ChatAgentSandboxAllowUnsandboxedCommands">ChatAgentSandboxAllowUnsandboxedCommands</string>
			<string id="ChatAgentSandboxAllowUnsandboxedCommands_agentSandbox_allowUnsandboxedCommands">Controla si los comandos de terminal del modo agente se pueden ejecutar fuera del espacio aislado después de la confirmación del usuario cuando se produce un error en un comando de espacio aislado o cuando las restricciones del espacio aislado bloquearían el comando. Esto solo se aplica cuando {0} está habilitado.</string>
			<string id="ChatAgentSandboxEnabled">ChatAgentSandboxEnabled</string>
			<string id="ChatAgentSandboxEnabled_agentSandbox_enabledSetting">Controla si el modo de agente usa el espacio aislado para restringir qué herramientas pueden hacer. Cuando se habilita, herramientas como el terminal se ejecutan en un entorno de espacio aislado para limitar el acceso al sistema. Se usa {0} para permitir todos los dominios de red.</string>
			<string id="ChatAgentSandboxEnabled_agentSandbox_enabledSetting_offDescription">Deshabilite el espacio aislado para las herramientas del modo agente.</string>
			<string id="ChatAgentSandboxEnabled_agentSandbox_enabledSetting_onDescription">Habilite el espacio aislado para las herramientas del modo agente.</string>
			<string id="ChatToolsTerminalEnableAutoApprove">ChatToolsTerminalEnableAutoApprove</string>
			<string id="ChatToolsTerminalEnableAutoApprove_autoApproveMode_description">Controla si se permite la aprobación automática en la herramienta de ejecución de terminal.</string>
			<string id="EnableFeedback">EnableFeedback</string>
			<string id="EnableFeedback_telemetry_feedback_enabled">Habilite mecanismos de comentarios, como el notificador de problemas, encuestas y otras opciones de comentarios.</string>
			<string id="TelemetryLevel">TelemetryLevel</string>
			<string id="TelemetryLevel_telemetry_telemetryLevel_policyDescription">Controla el nivel de telemetría.</string>
			<string id="TelemetryLevel_telemetry_telemetryLevel_default">Envía datos de uso, errores e informes de bloqueo.</string>
			<string id="TelemetryLevel_telemetry_telemetryLevel_error">Envía telemetría de errores generales e informes de bloqueo.</string>
			<string id="TelemetryLevel_telemetry_telemetryLevel_crash">Envía informes de bloqueo de nivel de sistema operativo.</string>
			<string id="TelemetryLevel_telemetry_telemetryLevel_off">Deshabilita toda la telemetría del producto.</string>
			<string id="UpdateMode">UpdateMode</string>
			<string id="UpdateMode_updateMode">Configure si desea recibir actualizaciones automáticas. Las actualizaciones se obtienen de un servicio en línea de Microsoft.</string>
			<string id="UpdateMode_none">Ninguno</string>
			<string id="UpdateMode_manual">Desactivar las comprobaciones automáticas de actualizaciones en segundo plano. Las actualizaciones estarán disponibles si comprueba manualmente las actualizaciones.</string>
			<string id="UpdateMode_start">Inicio</string>
			<string id="UpdateMode_default">Sistema</string>
		</stringTable>
