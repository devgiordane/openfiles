			<string id="Category_interactiveSessionConfigurationTitle">Session interactive</string>
			<string id="Category_extensionsConfigurationTitle">Extensions</string>
			<string id="Category_terminalIntegratedConfigurationTitle">Terminal intégré</string>
			<string id="Category_telemetryConfigurationTitle">Télémétrie</string>
			<string id="Category_updateConfigurationTitle">Mettre à jour</string>
			<string id="AgentsVoice">AgentsVoice</string>
			<string id="AgentsVoice_agents_voice_enabled">Activez le panneau Mode Voice dans la vue de conversation pour les conversations de codage pilotées par la voix.</string>
			<string id="BrowserChatTools">BrowserChatTools</string>
			<string id="BrowserChatTools_browser_enableChatTools">Lorsque cette option est activée, les assistants de conversation peuvent utiliser les outils du navigateur pour ouvrir des pages dans le navigateur intégré et interagir avec celles-ci.</string>
			<string id="ChatAgentAllowedNetworkDomains">ChatAgentAllowedNetworkDomains</string>
			<string id="ChatAgentAllowedNetworkDomains_chat_agent_allowedNetworkDomains">Domaines autorisés pour l’accès réseau par les outils de l’assistant (outil d’extraction, navigateur intégré). S’applique lorsque {0} ou {1} est activé. Lorsque {2} est activé, tous les domaines sont autorisés. Prend en charge les caractères génériques tels que {3}. Lorsque les listes d’autorisation et de refus sont toutes deux vides, tous les domaines sont bloqués. Les domaines refusés (voir {4}) sont prioritaires.</string>
			<string id="ChatAgentDeniedNetworkDomains">ChatAgentDeniedNetworkDomains</string>
			<string id="ChatAgentDeniedNetworkDomains_chat_agent_deniedNetworkDomains">Domaines refusés pour l’accès réseau par les outils de l’assistant (outil d’extraction, navigateur intégré). S’applique lorsque {0} ou {1} est activé. Cela ne s’applique pas lorsque {2} est activé. Est prioritaire sur {3}. Prend en charge les caractères génériques tels que {4}.</string>
			<string id="ChatAgentExtensionTools">ChatAgentExtensionTools</string>
			<string id="ChatAgentExtensionTools_chat_extensionToolsEnabled">Autorisez l’utilisation d’outils fournis par des extensions tierces.</string>
			<string id="ChatAgentHostCustomTerminalTool">ChatAgentHostCustomTerminalTool</string>
			<string id="ChatAgentHostCustomTerminalTool_chat_agentHost_customTerminalTool_enabled_policy">Enable the Agent Host custom terminal tool override for Copilot SDK sessions.</string>
			<string id="ChatAgentMode">ChatAgentMode</string>
			<string id="ChatAgentMode_chat_agent_enabled_description">Une fois activé, le mode assistant peut être activé depuis la conversation et des outils dans des contextes d'agent avec des effets secondaires peuvent être utilisés.</string>
			<string id="ChatAgentNetworkFilter">ChatAgentNetworkFilter</string>
			<string id="ChatAgentNetworkFilter_chat_agent_networkFilter">Lorsque cette option est activée, l’accès réseau par les outils de l’agent (outil d’extraction, navigateur intégré) est restreint en fonction de {0} et de {1}. Le filtrage de domaine est également appliqué à ces outils lorsque {2} est activé.</string>
			<string id="ChatAllowedMcpServers">ChatAllowedMcpServers</string>
			<string id="ChatAllowedMcpServers_chat_mcp_allowedServers_policy">Allowlist of Model Context Protocol servers. When set, only servers matching an entry may be installed or run; omit entirely to allow all servers (subject to the deny list).</string>
			<string id="ChatAllowManagedHooksOnly">ChatAllowManagedHooksOnly</string>
			<string id="ChatAllowManagedHooksOnly_chat_hooks_allowManagedOnly_policy">Allows hooks only from enterprise-managed sources and plugins force-enabled by policy.</string>
			<string id="ChatAllowManagedMcpServersOnly">ChatAllowManagedMcpServersOnly</string>
			<string id="ChatAllowManagedMcpServersOnly_chat_mcp_allowManagedServersOnly_policy">Use only the enterprise-managed MCP allowlist when deciding which servers may run.</string>
			<string id="ChatApprovedAccountOrganizations">ChatApprovedAccountOrganizations</string>
			<string id="ChatApprovedAccountOrganizations_chat_approvedAccountOrganizations_policy_description">Définir cette stratégie sur une liste non vide active la porte Compte approuvé : toutes les fonctionnalités d’IA sont désactivées jusqu’à ce que l’utilisateur se connecte à un compte GitHub dont les organisations croisent cette liste ET que les données de stratégie côté compte soient résolues. La comparaison ne tient pas compte de la casse. Utilisez « * » comme caractère générique pour accepter tout compte GitHub ou GitHub Enterprise connecté (utilisez-le pour les déploiements GitHub Enterprise où la liste des organisations n’est pas affichée).</string>
			<string id="ChatDefaultModel">ChatDefaultModel</string>
			<string id="ChatDefaultModel_chat_defaultModel_policy">Définit le modèle de conversation par défaut pour les nouvelles conversations. Accepte « auto », un nom de famille de modèles (tel que « opus » ou « gemini ») ou un ID de modèle complet. Les utilisateurs peuvent toujours changer de modèle dans une conversation.</string>
			<string id="ChatDeniedMcpServers">ChatDeniedMcpServers</string>
			<string id="ChatDeniedMcpServers_chat_mcp_deniedServers_policy">Denylist of Model Context Protocol servers. Servers matching any entry are blocked from being installed or run, even if they also match the allow list; deny rules always take precedence.</string>
			<string id="ChatEditorPreferCopilotHarness">ChatEditorPreferCopilotHarness</string>
			<string id="ChatEditorPreferCopilotHarness_chat_editor_preferCopilotHarness_policy">Configure whether VS Code uses the Agent Host Copilot SDK instead of the local harness for new editor chat sessions.</string>
			<string id="ChatEnabledPlugins">ChatEnabledPlugins</string>
			<string id="ChatEnabledPlugins_chat_plugins_enabledPlugins_policy">Activation de plug-ins. Les clés sont des ID de plug-in au format `{plugin}@{marketplace}` ; les valeurs activent ou désactivent le plug-in.</string>
			<string id="ChatExtraMarketplaces">ChatExtraMarketplaces</string>
			<string id="ChatExtraMarketplaces_chat_plugins_extraMarketplaces_policy">Additional plugin marketplaces to query. Keys are marketplace names; values are GitHub shorthand (`owner/repo[#ref]`) or Git URIs (`{url}[#ref]`), optionally with an enterprise-managed auto-update override.</string>
			<string id="ChatHooks">ChatHooks</string>
			<string id="ChatHooks_chat_useHooks_description">Controls whether chat hooks are executed at strategic points during an agent's workflow. Hooks are loaded from the files configured in `#chat.hookFilesLocations#`. This setting is only used by the Local agent harness.</string>
			<string id="ChatMCP">ChatMCP</string>
			<string id="ChatMCP_chat_mcp_access">Contrôle l’accès aux serveurs de protocole de contexte du modèle.</string>
			<string id="ChatMCP_chat_mcp_access_none">Aucun accès aux serveurs MCP.</string>
			<string id="ChatMCP_chat_mcp_access_registry">Allows access to MCP servers listed in the registry that VS Code is connected to.</string>
			<string id="ChatMCP_chat_mcp_access_any">Autorisez l’accès à tout serveur MCP installé.</string>
			<string id="ChatPluginsEnabled">ChatPluginsEnabled</string>
			<string id="ChatPluginsEnabled_chat_plugins_enabled">Activez l’intégration du plug-in d’assistant dans la conversation.</string>
			<string id="ChatStrictMarketplaces">ChatStrictMarketplaces</string>
			<string id="ChatStrictMarketplaces_chat_plugins_strictMarketplaces_policy">Liste verte des sources de la Place de marché des plug-ins. Lorsque cette valeur est définie, seules les places de marché correspondant à une entrée sont approuvées ; un tableau vide bloque toutes les places de marché.</string>
			<string id="ChatStrictPluginOnlyCustomization">ChatStrictPluginOnlyCustomization</string>
			<string id="ChatStrictPluginOnlyCustomization_chat_customizations_strictPluginOnlyCustomization_policy">Blocks standalone user and workspace skills, agents, hooks, instructions, and MCP servers while keeping eligible plugin customizations available.</string>
			<string id="ChatToolsAutoApprove">ChatToolsAutoApprove</string>
			<string id="ChatToolsAutoApprove_autoApprove3_description">L’approbation automatique globale, également appelée « mode YOLO », désactive complètement l’approbation manuelle pour tous les outils dans tous les espaces de travail, permettant à l’assistant d’agir de manière totalement autonome. Ceci est extrêmement dangereux et n’est *jamais* recommandé, même dans des environnements conteneurisés comme les [Codespaces](https://github.com/features/codespaces) et les [Conteneurs de développement](https://marketplace.visualstudio.com/items?itemName=ms-vscode-remote.remote-containers), où des clés utilisateur sont transférées dans le conteneur et pourraient être compromises.

Cette fonctionnalité désactive [les protections de sécurité critiques](https://code.visualstudio.com/docs/copilot/security) et facilite considérablement la compromission de la machine par un attaquant.

Note : ce paramètre ne contrôle que l’approbation d’outil et n’empêche pas l’assistant de poser des questions. Pour répondre automatiquement aux questions de l’assistant, utilisez le paramètre `#chat.autoReply#`.</string>
			<string id="ChatToolsEligibleForAutoApproval">ChatToolsEligibleForAutoApproval</string>
			<string id="ChatToolsEligibleForAutoApproval_chat_tools_eligibleForAutoApproval">Contrôle les outils éligibles à l’approbation automatique. Les outils définis sur « false » demandent toujours une confirmation et n’offrent jamais l’option d’approbation automatique. Le comportement par défaut (ou la définition d’un outil sur « true ») peut amener l’outil à proposer des options d’approbation automatique.</string>
			<string id="Claude3PIntegration">Claude3PIntegration</string>
			<string id="Claude3PIntegration_chat_agentHost_claudeAgent_enabled_policy">Activez les sessions de l’assistant Claude dans VS Code. Lancez et reprenez des sessions de codage agentique alimentées par le Kit de développement logiciel (SDK) de l’assistant Claude Anthropic directement dans l’éditeur. Utilisez votre abonnement Copilot existant.</string>
			<string id="Codex3PIntegration">Codex3PIntegration</string>
			<string id="Codex3PIntegration_chat_agentHost_codexAgent_enabled_policy">Enable Codex Agent sessions in VS Code. Start and resume agentic coding sessions powered by OpenAI Codex. Usage can be routed through GitHub Copilot or authenticated directly with an OpenAI account.</string>
			<string id="CopilotNextEditSuggestions">CopilotNextEditSuggestions</string>
			<string id="CopilotNextEditSuggestions_github_copilot_nextEditSuggestions_enabled">Whether to enable next edit suggestions (NES). NES can propose a next edit based on your recent changes.</string>
			<string id="CopilotOtelCaptureContent">CopilotOtelCaptureContent</string>
			<string id="CopilotOtelCaptureContent_chat_agentHost_otel_captureContent_policy">Contrôle si l’export OpenTelemetry de Copilot capture le contenu de l’invite, de la réponse et des outils.</string>
			<string id="CopilotOtelEnabled">CopilotOtelEnabled</string>
			<string id="CopilotOtelEnabled_chat_agentHost_otel_enabled_policy">Contrôle si l’export OpenTelemetry de Copilot est activé. Lorsqu’il est géré, les utilisateurs ne peuvent pas remplacer la valeur de l’entreprise.</string>
			<string id="CopilotOtelEndpoint">CopilotOtelEndpoint</string>
			<string id="CopilotOtelEndpoint_chat_agentHost_otel_otlpEndpoint_policy">Contrôle le point de terminaison du collecteur OTLP géré par l’entreprise pour l’exportation Copilot OpenTelemetry.</string>
			<string id="CopilotOtelHeaders">CopilotOtelHeaders</string>
			<string id="CopilotOtelHeaders_chat_agentHost_otel_headers_policy">Contrôle les en-têtes de l’exportateur OTLP gérés par l’entreprise pour l’export OpenTelemetry de Copilot.</string>
			<string id="CopilotOtelOtlpProtocol">CopilotOtelOtlpProtocol</string>
			<string id="CopilotOtelOtlpProtocol_chat_agentHost_otel_otlpProtocol_policy">Contrôle le protocole filaire OTLP géré par l’entreprise (protobuf ou JSON) pour l’export OpenTelemetry de Copilot.</string>
			<string id="CopilotOtelOutfile">CopilotOtelOutfile</string>
			<string id="CopilotOtelOutfile_chat_agentHost_otel_outfile_policy">Empêche l’export local des fichiers lorsque l’export OpenTelemetry de Copilot géré par l’entreprise est configuré.</string>
			<string id="CopilotOtelProtocol">CopilotOtelProtocol</string>
			<string id="CopilotOtelProtocol_chat_agentHost_otel_protocol_policy">Contrôle le protocole OTLP géré par l’entreprise pour l’export OpenTelemetry de Copilot.</string>
			<string id="CopilotOtelProtocol_chat_agentHost_otel_protocol_policy_otlpHttp">Utilisez OTLP sur HTTP.</string>
			<string id="CopilotOtelProtocol_chat_agentHost_otel_protocol_policy_otlpGrpc">Utilisez OTLP sur gRPC.</string>
			<string id="CopilotOtelProtocol_chat_agentHost_otel_protocol_policy_console">L’exportateur de console n’est pas sélectionné par les paramètres gérés par l’entreprise.</string>
			<string id="CopilotOtelProtocol_chat_agentHost_otel_protocol_policy_file">L’exportateur de fichiers n’est pas sélectionné par les paramètres gérés par l’entreprise.</string>
			<string id="CopilotOtelResourceAttributes">CopilotOtelResourceAttributes</string>
			<string id="CopilotOtelResourceAttributes_chat_agentHost_otel_resourceAttributes_policy">Contrôle les attributs de ressource OTel gérés par l’entreprise pour l’export OpenTelemetry de Copilot.</string>
			<string id="CopilotOtelServiceName">CopilotOtelServiceName</string>
			<string id="CopilotOtelServiceName_chat_agentHost_otel_serviceName_policy">Contrôle l’attribut de ressource OTel `service.name` géré par l’entreprise pour l’export OpenTelemetry de Copilot.</string>
			<string id="CopilotReviewAgent">CopilotReviewAgent</string>
			<string id="CopilotReviewAgent_github_copilot_chat_reviewAgent_enabled">Enables the code review agent.</string>
			<string id="CopilotReviewSelection">CopilotReviewSelection</string>
			<string id="CopilotReviewSelection_github_copilot_chat_reviewSelection_enabled">Enables code review on current selection.</string>
			<string id="CopilotSessionSync">CopilotSessionSync</string>
			<string id="CopilotSessionSync_chat_sessionSync_enabled_policy">Activez la synchronisation de session vers GitHub.com pour l’historique des sessions Copilot sur tous les appareils. Lorsque cette option est désactivée par la stratégie de l’entreprise, les données de session restent uniquement en local.</string>
			<string id="DictationEnabled">DictationEnabled</string>
			<string id="DictationEnabled_dictation_enabled_policy">Controls whether dictation is available across the product (chat input, editor, and terminal).</string>
			<string id="DictationLLMCleanup">DictationLLMCleanup</string>
			<string id="DictationLLMCleanup_dictation_experimental_llmCleanup_policy">Controls whether final dictation transcripts are sent to a language model for cleanup.</string>
			<string id="DictationModel">DictationModel</string>
			<string id="DictationModel_dictation_model_policy">Controls the transcription model used for dictation.</string>
			<string id="DictationModel_dictation_model_nemotronMultilingual_policy">Use the on-device transcription model. Audio does not leave the device.</string>
			<string id="DictationModel_dictation_model_mai_policy">Use the cloud transcription service. Audio is streamed to the service.</string>
			<string id="McpEnterpriseManagedAuthIdp">McpEnterpriseManagedAuthIdp</string>
			<string id="McpEnterpriseManagedAuthIdp_mcp_enterpriseManagedAuth_idp_policy">Configuration de fournisseur d’identité OAuth/OIDC utilisée pour l’authentification de serveur Model Context Protocol (MCP) gérés par l’entreprise.</string>
			<string id="McpGalleryServiceUrl">McpGalleryServiceUrl</string>
			<string id="McpGalleryServiceUrl_mcp_gallery_serviceUrl">Configurer l’URL du service de la galerie MCP à laquelle se connecter</string>
			<string id="AllowedExtensions">AllowedExtensions</string>
			<string id="AllowedExtensions_extensions_allowed_policy">Spécifiez une liste d’extensions autorisées. Cela permet de maintenir un environnement de développement sécurisé et cohérent en limitant l’utilisation d’extensions non autorisées. Plus d’informations : https://aka.ms/vscode/enterprise/extensions/allowed</string>
			<string id="ExtensionGalleryAuthProvider">ExtensionGalleryAuthProvider</string>
			<string id="ExtensionGalleryAuthProvider_extensions_gallery_authProvider">Configure the authentication provider for the Extensions Marketplace</string>
			<string id="ExtensionGalleryAuthProvider_extensions_gallery_authProvider_github">Authenticate to the Extensions Marketplace using GitHub.</string>
			<string id="ExtensionGalleryAuthProvider_extensions_gallery_authProvider_microsoft">Authenticate to the Extensions Marketplace using a Microsoft (Entra ID) account.</string>
			<string id="ExtensionGalleryServiceUrl">ExtensionGalleryServiceUrl</string>
			<string id="ExtensionGalleryServiceUrl_extensions_gallery_serviceUrl">Configurer l’URL du service Marketplace à laquelle se connecter</string>
			<string id="ExtensionsAutoUpdate">ExtensionsAutoUpdate</string>
			<string id="ExtensionsAutoUpdate_extensions_autoUpdate">Contrôle le comportement de mise à jour automatique des extensions. Les mises à jour sont récupérées à partir d'un service en ligne Microsoft.</string>
			<string id="ExtensionsAutoUpdate_extensions_autoUpdate_on">Téléchargez et installez automatiquement les mises à jour uniquement pour les extensions activées.</string>
			<string id="ExtensionsAutoUpdate_extensions_autoUpdate_off">Les extensions ne sont pas mises à jour automatiquement.</string>
			<string id="ExtensionsAutoUpdateDelay">ExtensionsAutoUpdateDelay</string>
			<string id="ExtensionsAutoUpdateDelay_extensions_autoUpdateDelay">Contrôle le délai en heures après la publication d’une mise à jour d’extension avant son installation automatique. S’applique uniquement lorsque `#extensions.autoUpdate#` est défini sur `on`. Ce délai permet d’éviter d’installer des mises à jour potentiellement problématiques immédiatement après la publication.</string>
			<string id="ChatAgentSandboxAllowAutoApprove">ChatAgentSandboxAllowAutoApprove</string>
			<string id="ChatAgentSandboxAllowAutoApprove_agentSandbox_allowAutoApprove">Contrôle si les commandes de terminal en mode agent exécutées au sein du bac à sable sont automatiquement approuvées. Lorsqu'il est désactivé, l'outil « Exécuter dans le terminal » utilise le flux d'approbation existant. Ceci ne s'applique que lorsque {0} est activé.</string>
			<string id="ChatAgentSandboxAllowNetwork">ChatAgentSandboxAllowNetwork</string>
			<string id="ChatAgentSandboxAllowNetwork_agentSandbox_allowNetwork">Lorsque {0} est activé, contrôle s’il faut autoriser tous les domaines réseau dans le bac à sable. Lorsqu’il est activé, le bac à sable conserve les restrictions du système de fichiers tout en assouplissant toutes les restrictions réseau.</string>
			<string id="ChatAgentSandboxAllowUnsandboxedCommands">ChatAgentSandboxAllowUnsandboxedCommands</string>
			<string id="ChatAgentSandboxAllowUnsandboxedCommands_agentSandbox_allowUnsandboxedCommands">Contrôle si les commandes de terminal en mode agent peuvent s'exécuter en dehors du bac à sable, après confirmation de l'utilisateur, lorsqu'une commande exécutée dans le bac à sable échoue ou lorsque les restrictions du bac à sable bloqueraient la commande. Ceci ne s'applique que lorsque {0} est activé.</string>
			<string id="ChatAgentSandboxEnabled">ChatAgentSandboxEnabled</string>
			<string id="ChatAgentSandboxEnabled_agentSandbox_enabledSetting">Contrôle si le mode assistant utilise la mise en bac à sable pour restreindre les actions des outils. Lorsqu’il est activé, les outils comme le terminal s’exécutent dans un environnement mis en mode bac à sable pour limiter l’accès au système. Utilisez {0} pour autoriser tous les domaines réseau.</string>
			<string id="ChatAgentSandboxEnabled_agentSandbox_enabledSetting_offDescription">Désactivez la mise en bac à sable pour les outils en mode assistant.</string>
			<string id="ChatAgentSandboxEnabled_agentSandbox_enabledSetting_onDescription">Activez la mise en bac à sable pour les outils en mode assistant.</string>
			<string id="ChatToolsTerminalEnableAutoApprove">ChatToolsTerminalEnableAutoApprove</string>
			<string id="ChatToolsTerminalEnableAutoApprove_autoApproveMode_description">Contrôle s’il faut autoriser l’approbation automatique lors de l’exécution dans l’outil terminal.</string>
			<string id="EnableFeedback">EnableFeedback</string>
			<string id="EnableFeedback_telemetry_feedback_enabled">Activez les mécanismes de commentaires tels que le système de rapport de problèmes, les sondages et autres options de commentaires.</string>
			<string id="TelemetryLevel">TelemetryLevel</string>
			<string id="TelemetryLevel_telemetry_telemetryLevel_policyDescription">Contrôle le niveau de télémétrie.</string>
			<string id="TelemetryLevel_telemetry_telemetryLevel_default">Envoie les données d'utilisation, les erreurs et les rapports d'erreur.</string>
			<string id="TelemetryLevel_telemetry_telemetryLevel_error">Envoie la télémétrie d'erreur générale et les rapports de plantage.</string>
			<string id="TelemetryLevel_telemetry_telemetryLevel_crash">Envoie des rapports de plantage au niveau du système d'exploitation.</string>
			<string id="TelemetryLevel_telemetry_telemetryLevel_off">Désactive toutes les données de télémétrie du produit.</string>
			<string id="UpdateMode">UpdateMode</string>
			<string id="UpdateMode_updateMode">Choisissez si vous voulez recevoir des mises à jour automatiques. Les mises à jour sont récupérées auprès d’un service en ligne Microsoft.</string>
			<string id="UpdateMode_none">Aucun</string>
			<string id="UpdateMode_manual">Désactivez la recherche de mises à jour automatique en arrière-plan. Les mises à jour sont disponibles si vous les rechercher manuellement.</string>
			<string id="UpdateMode_start">Démarrer</string>
			<string id="UpdateMode_default">Système</string>
		</stringTable>
		<presentationTable>
			<presentation id="AgentsVoice"><checkBox refId="AgentsVoice">AgentsVoice</checkBox></presentation>
