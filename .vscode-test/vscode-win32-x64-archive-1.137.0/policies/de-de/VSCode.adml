			<string id="Category_interactiveSessionConfigurationTitle">Interaktive Sitzung</string>
			<string id="Category_extensionsConfigurationTitle">Erweiterungen</string>
			<string id="Category_terminalIntegratedConfigurationTitle">Integriertes Terminal</string>
			<string id="Category_telemetryConfigurationTitle">Telemetrie</string>
			<string id="Category_updateConfigurationTitle">Aktualisieren</string>
			<string id="AgentsVoice">AgentsVoice</string>
			<string id="AgentsVoice_agents_voice_enabled">Aktivieren Sie den Bereich „Sprach-Modus“ in der Chatansicht für sprachgesteuerte Codierungsunterhaltungen.</string>
			<string id="BrowserChatTools">BrowserChatTools</string>
			<string id="BrowserChatTools_browser_enableChatTools">Wenn aktiviert, können Chatkräfte Browsertools verwenden, um Seiten im integrierten Browser zu öffnen und mit ihnen zu interagieren.</string>
			<string id="ChatAgentAllowedNetworkDomains">ChatAgentAllowedNetworkDomains</string>
			<string id="ChatAgentAllowedNetworkDomains_chat_agent_allowedNetworkDomains">Zulässige Domänen für den Netzwerkzugriff durch Agententools (Fetch-Tool, integrierter Browser). Gilt, wenn {0} oder {1} aktiviert ist. Wenn {2} aktiviert ist, sind alle Domänen erlaubt. Unterstützt Platzhalter wie {3}. Sind sowohl die Zulassungs- als auch die Sperrlisten leer, werden alle Domänen blockiert. Gesperrte Domänen (siehe {4}) haben Vorrang.</string>
			<string id="ChatAgentDeniedNetworkDomains">ChatAgentDeniedNetworkDomains</string>
			<string id="ChatAgentDeniedNetworkDomains_chat_agent_deniedNetworkDomains">Abgelehnte Domänen für den Netzwerkzugriff durch Agententools (Fetch-Tool, integrierter Browser). Gilt, wenn {0} oder {1} aktiviert ist. Dies gilt nicht, wenn {2} aktiviert ist. Hat Vorrang vor {3}. Unterstützt Platzhalter wie {4}.</string>
			<string id="ChatAgentExtensionTools">ChatAgentExtensionTools</string>
			<string id="ChatAgentExtensionTools_chat_extensionToolsEnabled">Aktivieren Sie die Verwendung von Tools, die von Drittanbietererweiterungen bereitgestellt wurden.</string>
			<string id="ChatAgentHostCustomTerminalTool">ChatAgentHostCustomTerminalTool</string>
			<string id="ChatAgentHostCustomTerminalTool_chat_agentHost_customTerminalTool_enabled_policy">Enable the Agent Host custom terminal tool override for Copilot SDK sessions.</string>
			<string id="ChatAgentMode">ChatAgentMode</string>
			<string id="ChatAgentMode_chat_agent_enabled_description">Wenn diese Option aktiviert ist, kann der Agent-Modus über Chats aktiviert werden, und Tools in Agent-Kontexten können mit Nebeneffekten verwendet werden.</string>
			<string id="ChatAgentNetworkFilter">ChatAgentNetworkFilter</string>
			<string id="ChatAgentNetworkFilter_chat_agent_networkFilter">Wenn diese Option aktiviert ist, wird der Netzwerkzugriff durch Agententools (Fetch-Tool, integrierter Browser) gemäß {0} und {1} eingeschränkt. Die Domänenfilterung wird auch auf diese Tools angewendet, wenn {2} aktiviert ist.</string>
			<string id="ChatAllowedMcpServers">ChatAllowedMcpServers</string>
			<string id="ChatAllowedMcpServers_chat_mcp_allowedServers_policy">Allowlist of Model Context Protocol servers. When set, only servers matching an entry may be installed or run; omit entirely to allow all servers (subject to the deny list).</string>
			<string id="ChatAllowManagedHooksOnly">ChatAllowManagedHooksOnly</string>
			<string id="ChatAllowManagedHooksOnly_chat_hooks_allowManagedOnly_policy">Allows hooks only from enterprise-managed sources and plugins force-enabled by policy.</string>
			<string id="ChatAllowManagedMcpServersOnly">ChatAllowManagedMcpServersOnly</string>
			<string id="ChatAllowManagedMcpServersOnly_chat_mcp_allowManagedServersOnly_policy">Use only the enterprise-managed MCP allowlist when deciding which servers may run.</string>
			<string id="ChatApprovedAccountOrganizations">ChatApprovedAccountOrganizations</string>
			<string id="ChatApprovedAccountOrganizations_chat_approvedAccountOrganizations_policy_description">Wenn Sie diese Richtlinie auf eine nicht leere Liste festlegen, wird das Gate „Zugelassenes Konto“ aktiviert: Alle KI-Features werden deaktiviert, bis sich der Benutzer bei einem GitHub-Konto anmeldet, dessen Organisationen diese Liste überschneiden, UND die kontoseitigen Richtliniendaten aufgelöst wurden. Beim Vergleich wird die Groß-/Kleinschreibung nicht beachtet. Verwenden Sie „*“ als Platzhalter, um alle angemeldeten GitHub- oder GHE-Konten zu akzeptieren (verwenden Sie diese Option für GHE-Bereitstellungen, bei denen die Organisationsliste nicht angezeigt wird).</string>
			<string id="ChatDefaultModel">ChatDefaultModel</string>
			<string id="ChatDefaultModel_chat_defaultModel_policy">Legt das Standardchatmodell für neue Unterhaltungen fest. Akzeptiert "auto", einen Modellfamiliennamen (z. B. "opus" oder "gemini") oder eine vollständige Modell-ID. Benutzer können das Modell weiterhin innerhalb einer Unterhaltung wechseln.</string>
			<string id="ChatDeniedMcpServers">ChatDeniedMcpServers</string>
			<string id="ChatDeniedMcpServers_chat_mcp_deniedServers_policy">Denylist of Model Context Protocol servers. Servers matching any entry are blocked from being installed or run, even if they also match the allow list; deny rules always take precedence.</string>
			<string id="ChatEditorPreferCopilotHarness">ChatEditorPreferCopilotHarness</string>
			<string id="ChatEditorPreferCopilotHarness_chat_editor_preferCopilotHarness_policy">Configure whether VS Code uses the Agent Host Copilot SDK instead of the local harness for new editor chat sessions.</string>
			<string id="ChatEnabledPlugins">ChatEnabledPlugins</string>
			<string id="ChatEnabledPlugins_chat_plugins_enabledPlugins_policy">Plug-in-Aktivierung Schlüssel sind Plug-in-IDs in der Form `{plugin}@{marketplace}`. Werte aktivieren oder deaktivieren das Plug-in.</string>
			<string id="ChatExtraMarketplaces">ChatExtraMarketplaces</string>
			<string id="ChatExtraMarketplaces_chat_plugins_extraMarketplaces_policy">Additional plugin marketplaces to query. Keys are marketplace names; values are GitHub shorthand (`owner/repo[#ref]`) or Git URIs (`{url}[#ref]`), optionally with an enterprise-managed auto-update override.</string>
			<string id="ChatHooks">ChatHooks</string>
			<string id="ChatHooks_chat_useHooks_description">Controls whether chat hooks are executed at strategic points during an agent's workflow. Hooks are loaded from the files configured in `#chat.hookFilesLocations#`. This setting is only used by the Local agent harness.</string>
			<string id="ChatMCP">ChatMCP</string>
			<string id="ChatMCP_chat_mcp_access">Steuert den Zugriff auf installierte Server des Modellkontextprotokolls.</string>
			<string id="ChatMCP_chat_mcp_access_none">Kein Zugriff auf MCP-Server.</string>
			<string id="ChatMCP_chat_mcp_access_registry">Allows access to MCP servers listed in the registry that VS Code is connected to.</string>
			<string id="ChatMCP_chat_mcp_access_any">Lassen Sie den Zugriff auf alle installierten MCP-Server zu.</string>
			<string id="ChatPluginsEnabled">ChatPluginsEnabled</string>
			<string id="ChatPluginsEnabled_chat_plugins_enabled">Agenten-Plug-in-Integration im Chat aktivieren</string>
			<string id="ChatStrictMarketplaces">ChatStrictMarketplaces</string>
			<string id="ChatStrictMarketplaces_chat_plugins_strictMarketplaces_policy">Positivliste für Quellen des Plug-in-Marketplace. Wenn diese festgelegt ist, gelten nur Marketplaces als vertrauenswürdig, die einem Eintrag entsprechen; ein leeres Array blockiert alle Marketplaces.</string>
			<string id="ChatStrictPluginOnlyCustomization">ChatStrictPluginOnlyCustomization</string>
			<string id="ChatStrictPluginOnlyCustomization_chat_customizations_strictPluginOnlyCustomization_policy">Blocks standalone user and workspace skills, agents, hooks, instructions, and MCP servers while keeping eligible plugin customizations available.</string>
			<string id="ChatToolsAutoApprove">ChatToolsAutoApprove</string>
			<string id="ChatToolsAutoApprove_autoApprove3_description">Die globale automatische Genehmigung, auch bekannt als „YOLO-Modus“, deaktiviert die manuelle Genehmigung vollständig für alle Tools in allen Arbeitsbereichen, sodass der Agent völlig autonom handeln kann. Das ist äußerst gefährlich und wird *niemals* empfohlen, selbst in containerisierten Umgebungen wie Codespaces und Dev-Containern werden Benutzerschlüssel in den Container weitergeleitet, der kompromittiert werden könnte.

Diese Funktion deaktiviert wichtige Sicherheitsvorkehrungen und macht es viel leichter für Angreifer, den Computer zu kompromittieren.

Hinweis: Diese Einstellung steuert nur die Toolgenehmigung und verhindert nicht, dass der Agent Fragen stellt. Um Agent-Fragen automatisch zu beantworten, verwenden Sie die Einstellung `#chat.autoReply#`.</string>
			<string id="ChatToolsEligibleForAutoApproval">ChatToolsEligibleForAutoApproval</string>
			<string id="ChatToolsEligibleForAutoApproval_chat_tools_eligibleForAutoApproval">Steuert, welche Tools für die automatische Genehmigung infrage kommen. Tools, die auf „false“ gesetzt sind, zeigen immer eine Bestätigung an und bieten niemals die Option zur automatischen Genehmigung an. Das Standardverhalten (oder das Setzen eines Tools auf „true“) kann dazu führen, dass das Tool Optionen zur automatischen Genehmigung anbietet.</string>
			<string id="Claude3PIntegration">Claude3PIntegration</string>
			<string id="Claude3PIntegration_chat_agentHost_claudeAgent_enabled_policy">Aktivieren Sie Claude-Agentsitzungen in VS Code. Starten und setzen Sie agentspezifische Codierungssitzungen fort, die direkt im Editor vom Claude-Agent-SDK von Anthropic unterstützt werden. Verwendet Ihr bestehendes Copilot-Abonnement.</string>
			<string id="Codex3PIntegration">Codex3PIntegration</string>
			<string id="Codex3PIntegration_chat_agentHost_codexAgent_enabled_policy">Enable Codex Agent sessions in VS Code. Start and resume agentic coding sessions powered by OpenAI Codex. Usage can be routed through GitHub Copilot or authenticated directly with an OpenAI account.</string>
			<string id="CopilotNextEditSuggestions">CopilotNextEditSuggestions</string>
			<string id="CopilotNextEditSuggestions_github_copilot_nextEditSuggestions_enabled">Whether to enable next edit suggestions (NES). NES can propose a next edit based on your recent changes.</string>
			<string id="CopilotOtelCaptureContent">CopilotOtelCaptureContent</string>
			<string id="CopilotOtelCaptureContent_chat_agentHost_otel_captureContent_policy">Steuert, ob der Copilot OpenTelemetry-Export Eingabeaufforderungen, Antworten und Toolinhalte erfasst.</string>
			<string id="CopilotOtelEnabled">CopilotOtelEnabled</string>
			<string id="CopilotOtelEnabled_chat_agentHost_otel_enabled_policy">Steuert, ob der Copilot OpenTelemetry-Export aktiviert ist. Bei der Verwaltung können Benutzer den Unternehmenswert nicht überschreiben.</string>
			<string id="CopilotOtelEndpoint">CopilotOtelEndpoint</string>
			<string id="CopilotOtelEndpoint_chat_agentHost_otel_otlpEndpoint_policy">Steuert den vom Unternehmen verwalteten OTLP-Collectorendpunkt für den Copilot OpenTelemetry-Export.</string>
			<string id="CopilotOtelHeaders">CopilotOtelHeaders</string>
			<string id="CopilotOtelHeaders_chat_agentHost_otel_headers_policy">Steuert die vom Unternehmen verwalteten OTLP-Exporterheader für den Copilot OpenTelemetry-Export.</string>
			<string id="CopilotOtelOtlpProtocol">CopilotOtelOtlpProtocol</string>
			<string id="CopilotOtelOtlpProtocol_chat_agentHost_otel_otlpProtocol_policy">Steuert das vom Unternehmen verwaltete OTLP-Wire Protocol (protobuf vs JSON) für den Copilot OpenTelemetry-Export.</string>
			<string id="CopilotOtelOutfile">CopilotOtelOutfile</string>
			<string id="CopilotOtelOutfile_chat_agentHost_otel_outfile_policy">Verhindert den lokalen Dateiexport, wenn der vom Unternehmen verwaltete Copilot OpenTelemetry-Export konfiguriert ist.</string>
			<string id="CopilotOtelProtocol">CopilotOtelProtocol</string>
			<string id="CopilotOtelProtocol_chat_agentHost_otel_protocol_policy">Steuert das vom Unternehmen verwaltete OTLP-Protokoll für den Copilot OpenTelemetry-Export.</string>
			<string id="CopilotOtelProtocol_chat_agentHost_otel_protocol_policy_otlpHttp">Verwenden Sie OTLP über HTTP.</string>
			<string id="CopilotOtelProtocol_chat_agentHost_otel_protocol_policy_otlpGrpc">Verwenden Sie OTLP über gRPC.</string>
			<string id="CopilotOtelProtocol_chat_agentHost_otel_protocol_policy_console">Der Konsolenexporter wird nicht von unternehmensseitig verwalteten Einstellungen ausgewählt.</string>
			<string id="CopilotOtelProtocol_chat_agentHost_otel_protocol_policy_file">Der Dateiexporter wird nicht von unternehmensseitig verwalteten Einstellungen ausgewählt.</string>
			<string id="CopilotOtelResourceAttributes">CopilotOtelResourceAttributes</string>
			<string id="CopilotOtelResourceAttributes_chat_agentHost_otel_resourceAttributes_policy">Steuert die vom Unternehmen verwalteten OTel-Ressourcenattribute für den Copilot OpenTelemetry-Export.</string>
			<string id="CopilotOtelServiceName">CopilotOtelServiceName</string>
			<string id="CopilotOtelServiceName_chat_agentHost_otel_serviceName_policy">Steuert das vom Unternehmen verwaltete OTel-Ressourcenattribut `service.name` für den Copilot OpenTelemetry-Export.</string>
			<string id="CopilotReviewAgent">CopilotReviewAgent</string>
			<string id="CopilotReviewAgent_github_copilot_chat_reviewAgent_enabled">Enables the code review agent.</string>
			<string id="CopilotReviewSelection">CopilotReviewSelection</string>
			<string id="CopilotReviewSelection_github_copilot_chat_reviewSelection_enabled">Enables code review on current selection.</string>
			<string id="CopilotSessionSync">CopilotSessionSync</string>
			<string id="CopilotSessionSync_chat_sessionSync_enabled_policy">Aktivieren Sie die Sitzungssynchronisierung mit GitHub.com für den geräteübergreifenden Copilot-Sitzungsverlauf. Wenn diese Option durch eine Organisationsrichtlinie deaktiviert ist, werden Sitzungsdaten nur lokal gespeichert.</string>
			<string id="DictationEnabled">DictationEnabled</string>
			<string id="DictationEnabled_dictation_enabled_policy">Controls whether dictation is available across the product (chat input, editor, and terminal).</string>
			<string id="DictationLLMCleanup">DictationLLMCleanup</string>
			<string id="DictationLLMCleanup_dictation_experimental_llmCleanup_policy">Controls whether final dictation transcripts are sent to a language model for cleanup.</string>
			<string id="DictationModel">DictationModel</string>
			<string id="DictationModel_dictation_model_policy">Controls the transcription model used for dictation.</string>
			<string id="DictationModel_dictation_model_nemotronMultilingual_policy">Use the on-device transcription model. Audio does not leave the device.</string>
			<string id="DictationModel_dictation_model_mai_policy">Use the cloud transcription service. Audio is streamed to the service.</string>
			<string id="McpEnterpriseManagedAuthIdp">McpEnterpriseManagedAuthIdp</string>
			<string id="McpEnterpriseManagedAuthIdp_mcp_enterpriseManagedAuth_idp_policy">Die OAuth/OIDC-IdP-Konfiguration für die Authentifizierung von unternehmensverwalteten MCP-Servern (Model Context Protocol).</string>
			<string id="McpGalleryServiceUrl">McpGalleryServiceUrl</string>
			<string id="McpGalleryServiceUrl_mcp_gallery_serviceUrl">Konfigurieren der URL des MCP-Katalogdiensts zum Herstellen einer Verbindung mit</string>
			<string id="AllowedExtensions">AllowedExtensions</string>
			<string id="AllowedExtensions_extensions_allowed_policy">Geben Sie eine Liste der zulässigen Erweiterungen an. Dies trägt dazu bei, eine sichere und konsistente Entwicklungsumgebung aufrechtzuerhalten, indem die Verwendung nicht autorisierter Erweiterungen eingeschränkt wird. Weitere Informationen: https://aka.ms/vscode/enterprise/extensions/allowed</string>
			<string id="ExtensionGalleryAuthProvider">ExtensionGalleryAuthProvider</string>
			<string id="ExtensionGalleryAuthProvider_extensions_gallery_authProvider">Configure the authentication provider for the Extensions Marketplace</string>
			<string id="ExtensionGalleryAuthProvider_extensions_gallery_authProvider_github">Authenticate to the Extensions Marketplace using GitHub.</string>
			<string id="ExtensionGalleryAuthProvider_extensions_gallery_authProvider_microsoft">Authenticate to the Extensions Marketplace using a Microsoft (Entra ID) account.</string>
			<string id="ExtensionGalleryServiceUrl">ExtensionGalleryServiceUrl</string>
			<string id="ExtensionGalleryServiceUrl_extensions_gallery_serviceUrl">Konfigurieren Sie die URL des Marketplace-Dienstes, um eine Verbindung herzustellen mit</string>
			<string id="ExtensionsAutoUpdate">ExtensionsAutoUpdate</string>
			<string id="ExtensionsAutoUpdate_extensions_autoUpdate">Steuert das Verhalten zur automatischen Aktualisierung von Erweiterungen. Die Aktualisierungen werden von einem Microsoft-Onlinedienst abgerufen.</string>
			<string id="ExtensionsAutoUpdate_extensions_autoUpdate_on">Updates werden nur für aktivierte Erweiterungen automatisch heruntergeladen und installiert.</string>
			<string id="ExtensionsAutoUpdate_extensions_autoUpdate_off">Hiermit werden Erweiterungen nicht automatisch aktualisiert.</string>
			<string id="ExtensionsAutoUpdateDelay">ExtensionsAutoUpdateDelay</string>
			<string id="ExtensionsAutoUpdateDelay_extensions_autoUpdateDelay">Steuert die Verzögerung in Stunden nach der Veröffentlichung eines Erweiterungsupdates, bevor es automatisch installiert wird. Gilt nur, wenn „`#extensions.autoUpdate#`“ auf `on` festgelegt ist. Durch diese Verzögerung werden potenziell problematische Updates nicht sofort nach der Veröffentlichung installiert.</string>
			<string id="ChatAgentSandboxAllowAutoApprove">ChatAgentSandboxAllowAutoApprove</string>
			<string id="ChatAgentSandboxAllowAutoApprove_agentSandbox_allowAutoApprove">Steuert, ob Terminalbefehle im Agent-Modus, die in der Sandbox ausgeführt werden, automatisch genehmigt werden. Wenn diese Option deaktiviert ist, verwendet die Ausführung im Terminaltool den vorhandenen Genehmigungsflow. Dies gilt nur, wenn {0} aktiviert ist.</string>
			<string id="ChatAgentSandboxAllowNetwork">ChatAgentSandboxAllowNetwork</string>
			<string id="ChatAgentSandboxAllowNetwork_agentSandbox_allowNetwork">Wenn {0} aktiviert ist, wird gesteuert, ob alle Netzwerkdomänen in der Sandbox zugelassen werden sollen. Wenn diese Option aktiviert ist, behält die Sandbox Dateisystemeinschränkungen bei und schränkt gleichzeitig alle Netzwerkeinschränkungen ein.</string>
			<string id="ChatAgentSandboxAllowUnsandboxedCommands">ChatAgentSandboxAllowUnsandboxedCommands</string>
			<string id="ChatAgentSandboxAllowUnsandboxedCommands_agentSandbox_allowUnsandboxedCommands">Steuert, ob Terminalbefehle im Agent-Modus außerhalb der Sandbox ausgeführt werden können, nachdem der Benutzer bestätigt wurde, wenn ein Sandboxbefehl fehlschlägt oder wenn Sandboxeinschränkungen den Befehl blockieren würden. Dies gilt nur, wenn {0} aktiviert ist.</string>
			<string id="ChatAgentSandboxEnabled">ChatAgentSandboxEnabled</string>
			<string id="ChatAgentSandboxEnabled_agentSandbox_enabledSetting">Legt fest, ob der Agentmodus Sandboxing verwendet, um die Funktionen von Tools einzuschränken. Wenn aktiviert, laufen Tools wie das Terminal in einer Sandboxumgebung, um den Systemzugriff zu begrenzen. {0} verwenden, um alle Netzwerkdomänen zuzulassen.</string>
			<string id="ChatAgentSandboxEnabled_agentSandbox_enabledSetting_offDescription">Deaktivieren Sie Sandboxing für Agentmodustools.</string>
			<string id="ChatAgentSandboxEnabled_agentSandbox_enabledSetting_onDescription">Aktivieren Sie Sandboxing für Agentmodustools.</string>
			<string id="ChatToolsTerminalEnableAutoApprove">ChatToolsTerminalEnableAutoApprove</string>
			<string id="ChatToolsTerminalEnableAutoApprove_autoApproveMode_description">Steuert, ob die automatische Genehmigung im Terminaltool zulässig ist.</string>
			<string id="EnableFeedback">EnableFeedback</string>
			<string id="EnableFeedback_telemetry_feedback_enabled">Aktivieren Sie Feedback-Mechanismen wie den Problem-Reporter, Umfragen und andere Feedback-Optionen.</string>
			<string id="TelemetryLevel">TelemetryLevel</string>
			<string id="TelemetryLevel_telemetry_telemetryLevel_policyDescription">Steuert den Grad der Telemetrie.</string>
			<string id="TelemetryLevel_telemetry_telemetryLevel_default">Sendet Nutzungsdaten, Fehler und Absturzberichte.</string>
			<string id="TelemetryLevel_telemetry_telemetryLevel_error">Sendet allgemeine Fehlertelemetrie- und Absturzberichte.</string>
			<string id="TelemetryLevel_telemetry_telemetryLevel_crash">Sendet Absturzberichte auf Betriebssystemebene.</string>
			<string id="TelemetryLevel_telemetry_telemetryLevel_off">Deaktiviert alle Produkttelemetriedaten.</string>
			<string id="UpdateMode">UpdateMode</string>
			<string id="UpdateMode_updateMode">Legen Sie fest, ob Sie automatische Updates erhalten möchten. Die Updates werden von einem Microsoft-Onlinedienst abgerufen.</string>
			<string id="UpdateMode_none">Keine</string>
			<string id="UpdateMode_manual">Automatisches Prüfen auf Updates im Hintergrund deaktivieren. Sie können Updates durchführen, indem Sie manuell danach suchen.</string>
			<string id="UpdateMode_start">Start</string>
			<string id="UpdateMode_default">System</string>
		</stringTable>
